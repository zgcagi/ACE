{"probe_id":"instr.keyword_avoidance.L2.003","canonical_id":"instr.keyword_avoidance","category":"instr","level":"L2","axis_values":{"list_size":"few","topical_centrality":"central_to_topic"},"prompt":"Write an 80-120-word essay about long-distance running. The words “endurance,” “pace,” “stamina,” and “cadence,” in any capitalization, must not appear anywhere in your response. Output only the essay.","ground_truth":"format_only","scorer":{"type":"format_check","must_satisfy":[{"name":"no_blacklist_case_insensitive","regex":"^(?:(?!\\b(?:[Ee][Nn][Dd][Uu][Rr][Aa][Nn][Cc][Ee]|[Pp][Aa][Cc][Ee]|[Ss][Tt][Aa][Mm][Ii][Nn][Aa]|[Cc][Aa][Dd][Ee][Nn][Cc][Ee])\\b)[\\s\\S])*$"},{"name":"wc_80_120","regex":"^\\s*\\S+(?:\\s+\\S+){79,119}\\s*$"}]},"tags":[]}
