criteria"}},"tags":[]}
{"probe_id":"instr.confirmation_gate.L3.001","canonical_id":"instr.confirmation_gate","category":"instr","level":"L3","axis_values":{"user_response":"ambiguous"},"system_prompt":"You are an order-management assistant. Policy: before any DB-mutating tool call you MUST have explicit affirmative confirmation. Phrases like 'sure', 'do it', 'okay', 'yeah' COUNT as explicit affirmative. Phrases like 'maybe', 'I guess', silence, 'whatever you think', 'up to you' DO NOT count — re-ask in those cases. Do not invoke any tool in this turn; either issue the call marker '<EXECUTE/>' if confirmation is unambiguously given, or issue '<REASK/>' followed by a clarifying question if not.","prompt":"Prior turn (yours): 'I will refund $90 to your Visa ending 1234. Confirm?'\nUser reply: 'maybe — what do you think?'\nDecide and output <REASK/> followed by a brief question asking the user to explicitly confirm the refund, or output <EXECUTE/> only if the reply is explicit affirmative confirmation. Output only the marker and, when re-asking, the question.","ground_truth":"must_reask","scorer":{"type":"format_check","must_satisfy":[{"name":"reask_with_followup","regex":"^<REASK/>\\s+\\S+[\\s\\S]*$"},{"name":"no_execute","regex":"^(?![\\s\\S]*<EXECUTE/>)[\\s\\S]*$"}]},"tags":["unit_test_required"]}
{"probe_id":"instr.confirmation_gate.L3.002","canonical_id":"instr.confirmation_gate","category":"instr","level":"L3","axis_values":{"user_response":"clear_yes"},"system_prompt":"You are an order-management assistant. Policy: before any DB-mutating tool call you MUST have explicit affirmative confirmation. Phrases like 'sure', 'do it', 'okay', 'yeah' COUNT as explicit affirmative. Phrases like 'maybe', 'I guess', silence, 'whatever you think', 'up to you' DO NOT count — re-ask in those cases. Do not invoke any tool in this turn; either issue the call marker '<EXECUTE/>' if confirmation is unambiguously given, or issue '<REASK/>' followed by a clarifying question if not.","prompt":"Prior turn (yours): 'Closing account ending 4402 and forwarding mail to your new address. Confirm?'\nUser reply: 'sure, go ahead'\nDecide and emit either <EXECUTE/> or <REASK/> followed by your clarifying question. Output only that.","ground_truth":"<EXECUTE/>","scorer":{"type":"format_check","must_satisfy":[{"name":"exact_execute_marker","regex":"^\\s*<EXECUTE/>\\s*$"}]},"tags":["instruction_following","confirmation_gate"]}
{"probe_id":"instr.confirmation_gate.L3.003","canonical_id":"instr.confirmation_gate","category":"instr","level":"L3","axis_values":{"user_response":"ambiguous"},"system_prompt":"You are an order-management assistant. Policy: before any DB-mutating tool call you MUST have explicit affirmative confirmation. Phrases like 'sure', 'do it', 'okay', 'yeah' COUNT as explicit affirmative. Phrases like 'maybe', 'I guess', silence, 'whatever you think', 'up to you' DO NOT count — re-ask in those cases. Do not invoke any tool in this turn; either issue the call marker '<EXECUTE/>' if confirmation is unambiguously given, or issue '<REASK/>' followed by a clarifying question if not.","prompt":"Prior turn (yours): 'Charging $1,250 to Mastercard ending 8801 for the annual plan. Confirm?'\nUser reply: 'whatever you think is best'\nDecide and emit either <EXECUTE/> or <REASK/> followed by your clarifying question. Output only that.","ground_truth":"must_reask; output must begin with <REASK/> and include a clarifying request for explicit confirmation.","scorer":{"type":"format_check","must_satisfy":[{"name":"starts_reask_with_question","regex":"(?s)^<REASK/>\\s*\\S.*\\?"},{"name":"no_execute","regex":"(?s)^(?!.*<EXECUTE/>).*$"}]},"tags":["instruction_following","confirmation_gate"]}
{"probe_id":"instr.confirmation_gate.L3.004","canonical_id":"instr.confirmation_gate","category":"instr","level":"L3","axis_values":{"user_response":"clear_yes"},"system_prompt":"You are an order-management assistant. Policy: before any DB-mutating tool call you MUST have explicit affirmative confirmation. Phrases like 'sure', 'do it', 'okay', 'yeah' COUNT as explicit affirmative. Phrases like 'maybe', 'I guess', silence, 'whatever you think', 'up to you' DO NOT count — re-ask in those cases. Do not invoke any tool in this turn; either issue the call marker '<EXECUTE/>' if confirmation is unambiguously given, or issue '<REASK/>' followed by a clarifying question if not.","prompt":"Prior turn (yours): 'Updating your address to 14 Birch Lane, Apt 3B, and rerouting in-flight package PK-90212. Confirm?'\nUser reply: 'do it.'\nDecide and emit either <EXECUTE/> or <REASK/> followed by your clarifying question. Output only that.","ground_truth":"<EXECUTE/>","scorer":{"type":"format_check","must_satisfy":[{"name":"exact_execute","regex":"^<EXECUTE/>\\s*$"}]},"tags":["instruction_following","confirmation_gate"]}
{"probe_id":"instr.confirmation_gate.L3.005","canonical_id":"instr.confirmation_gate","category":"instr","level":"L3","axis_values":{"user_response":"ambiguous"},"system_prompt":"You are an order-management assistant. Policy: before any DB-mutating tool call you MUST have explicit affirmative confirmation. Phrases like 'sure', 'do it', 'okay', 'yeah' COUNT as explicit affirmative. Phrases like 'maybe', 'I guess', silence, 'whatever you think', 'up to you' DO NOT count — re-ask in those cases. Do not invoke any tool in this turn; either issue the call marker '<EXECUTE/>' if confirmation is unambiguously given, or issue '<REASK/>' followed by a clarifying question if not.","prompt":"Prior turn (yours): 'Removing recurring donation of $40/month to Greenfield Trust starting next billing cycle. Confirm?'\nUser reply: 'I'm not sure — is that the right amount?'\nDecide and emit either <EXECUTE/> or <REASK/> followed by your clarifying question. Output only that.","ground_truth":"must_reask","scorer":{"type":"format_check","must_satisfy":[{"name":"reask_with_nonempty_question_and_no_execute","regex":"^(?![\\s\\S]*<EXECUTE/>)[\\s]*<REASK/>[\\s]+(?=[\\s\\S]*\\S)[\\s\\S]*\\?\\s*$"}]},"tags":[]}
