// instr.jsonl — category: instr — 13 atoms × 15 probes/atom = 195 probes
// Generator: /workspace/build/gen_instr.py
//
// Scorers used in this file:
//   format_check       — multi-regex predicate over the response (heaviest user)
//   exact_match_string — for verbatim emission and deterministic transformations
//   set_equal          — for unordered fixed answer sets
//   judge_rubric       — ONLY for instr.style_emulation (genuinely free-form)
//
// Design notes:
//   • Every probe ends with an explicit output-format instruction.
//   • format_check regexes use [\s\S] / [^X] tricks to do multi-line matching
//     since the platform regex flags are not specified.
//   • Word-count regexes use ^(?:\s*\S+){lo,hi}\s*$ which counts whitespace-
//     delimited tokens — a reasonable proxy for word count.
//   • For instr.confirmation_gate the scorer is permissive on phrasing but
//     enforces (a) listing of every key detail and (b) presence of an explicit
//     question, and (c) absence of any tool-call marker in the same turn.
//   • For instr.style_emulation, judge_rubric is unavoidable: the atom IS
//     stylistic. Rubrics are explicit checklists to keep judging consistent.
//   • Domains are varied within each level (gardening / cycling / cooking /
//     music / law / medicine / etc.) to avoid memorization shortcuts.
//   • For instr.multi_constraint_compliance L3 probes (L3.001–L3.005) the
//     scorer enforces the most observable constraints (wrappers, section
//     order, length bounds, keyword placement, exact-once tokens). Some
//     advertised constraints (e.g. 'Summary is exactly 2 sentences',
//     'timestamps strictly increasing', per-paragraph word counts) are not
//     regex-checkable; downstream graders may add custom Python checks.
//     Treat L3 as partially-graded probes — the atom is 'satisfy ≥2
//     orthogonal constraints'; partial-grading still discriminates models.
//   • All system_prompt fields, where set, declare a constraint that the user
//     turn alone cannot dislodge; this is what `instr.system_prompt_adherence`
//     and `instr.confirmation_gate` actually probe.
{"probe_id":"instr.multi_constraint_compliance.L1.001","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L1","axis_values":{"constraint_count":"3","constraint_types":"homogeneous"},"prompt":"Describe a typical breakfast using exactly three bullets. Each bullet must (1) begin with the literal '* ', (2) contain a meaningful description of a typical breakfast item or meal, (3) be exactly one sentence ending with a single final period, and (4) contain no commas. Output only the three bullets, nothing else.","ground_truth":"format_and_semantic_compliance","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Describe a typical breakfast using exactly three bullets. Each bullet must (1) begin with the literal '* ', (2) contain a meaningful description of a typical breakfast item or meal, (3) be exactly one sentence ending with a single final period, and (4) contain no commas. Output only the three bullets, nothing else."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L1.002","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L1","axis_values":{"constraint_count":"4","constraint_types":"homogeneous"},"prompt":"List four reasons people enjoy hiking. Constraints: (1) exactly four numbered items, labeled '1.' through '4.'; (2) each item must state a plausible reason people enjoy hiking; (3) each item contains at most ten words, counting words separated by spaces and excluding the item number; (4) each item ends with an exclamation mark. Output only the numbered list.","ground_truth":"Each output must contain exactly four correctly numbered items and satisfy all stated formatting constraints. Each item must express a plausible reason people enjoy hiking, such as enjoying nature, exercise, scenic views, fresh air, relaxation, challenge, or social time. Semantically equivalent reasons are accepted; unrelated fragments, empty content, and non-reasons are rejected.","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: List four reasons people enjoy hiking. Constraints: (1) exactly four numbered items, labeled '1.' through '4.'; (2) each item must state a plausible reason people enjoy hiking; (3) each item contains at most ten words, counting words separated by spaces and excluding the item number; (4) each item ends with an exclamation mark. Output only the numbered list."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L1.003","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L1","axis_values":{"constraint_count":"3","constraint_types":"homogeneous"},"prompt":"Write three short tips about staying hydrated. Each tip must be a practical recommendation related to drinking fluids or maintaining hydration. Constraints: (1) each tip is on its own line, (2) every line begins with the literal prefix 'Tip: ', (3) there are exactly three non-empty lines, and no other text. Output only the three lines.","ground_truth":"format_and_semantic_constraints","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Write three short tips about staying hydrated. Each tip must be a practical recommendation related to drinking fluids or maintaining hydration. Constraints: (1) each tip is on its own line, (2) every line begins with the literal prefix 'Tip: ', (3) there are exactly three non-empty lines, and no other text. Output only the three lines."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L1.004","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L1","axis_values":{"constraint_count":"3","constraint_types":"homogeneous"},"prompt":"Provide five short English headings for a tutorial about gardening. Constraints: (1) output exactly five lines, with no blank lines; (2) every line is wrapped in double asterisks like '**Heading**'; (3) each heading is exactly one ASCII-letter word; (4) each heading must name a gardening-related tutorial topic. Output only the five lines.","ground_truth":"format_and_semantic","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Provide five short English headings for a tutorial about gardening. Constraints: (1) output exactly five lines, with no blank lines; (2) every line is wrapped in double asterisks like '**Heading**'; (3) each heading is exactly one ASCII-letter word; (4) each heading must name a gardening-related tutorial topic. Output only the five lines."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L1.005","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L1","axis_values":{"constraint_count":"4","constraint_types":"homogeneous"},"prompt":"Compose three short slogans. Constraints: (1) each slogan is wrapped in straight double quotes, (2) each slogan is on its own line, (3) there are exactly three slogans, (4) each slogan ends with '!'. Output only the three quoted slogans.","ground_truth":"format_only","scorer":{"type":"format_check","must_satisfy":[{"name":"three_quoted_excl","regex":"^\\\"[^\\\"\\n]+!\\\"\\n\\\"[^\\\"\\n]+!\\\"\\n\\\"[^\\\"\\n]+!\\\"\\n?$"}]},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L2.001","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L2","axis_values":{"constraint_count":"8","constraint_types":"mixed_path_format_perm_content"},"prompt":"Write a short product blurb for a noise-cancelling headset. Constraints: (1) wrap the entire response in <BLURB> ... </BLURB>, with no text outside the tags; (2) inside the tags, include exactly two non-empty paragraphs separated by exactly one blank line; (3) the first paragraph begins with 'Designed'; (4) the second paragraph begins with 'Built'; (5) include the lowercase word 'battery' at least once; (6) include the lowercase word 'comfort' at least once; (7) total body word count must be between 40 and 80 words inclusive; (8) do not use the character ';'. The blurb must describe a noise-cancelling headset. Output only the wrapped blurb.","ground_truth":"format_and_content_constraints","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Write a short product blurb for a noise-cancelling headset. Constraints: (1) wrap the entire response in <BLURB> ... </BLURB>, with no text outside the tags; (2) inside the tags, include exactly two non-empty paragraphs separated by exactly one blank line; (3) the first paragraph begins with 'Designed'; (4) the second paragraph begins with 'Built'; (5) include the lowercase word 'battery' at least once; (6) include the lowercase word 'comfort' at least once; (7) total body word count must be between 40 and 80 words inclusive; (8) do not use the character ';'. The blurb must describe a noise-cancelling headset. Output only the wrapped blurb."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L2.002","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L2","axis_values":{"constraint_count":"7","constraint_types":"mixed_path_format_perm_content"},"prompt":"Write a brief travel advisory for visiting Reykjavik in winter. Output only the advisory. The first line must be exactly '## Advisory'. It must be followed immediately by exactly three bullet lines, each beginning with '- ', with no other text. Each bullet must be exactly one sentence ending in a period or exclamation mark. The third bullet must contain the standalone lowercase word 'aurora'. Do not use question marks. Count words by whitespace-separated alphabetic words, excluding the Markdown marker '##'; the total must be 60 to 120 words. The standalone word 'Iceland' must appear exactly twice.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"strict_instruction_with_local_observations","mechanical_requirements":["First line is exactly ## Advisory and is followed immediately by exactly three bullet lines beginning '- ', with no other lines.","Each bullet is exactly one sentence ending with period or exclamation mark; there are no question marks.","The alphabetic word count is 60–120 under the task definition.","candidate_observations.quoted_term_whole_word_counts.aurora is at least 1 and occurs in bullet 3.","candidate_observations.quoted_term_whole_word_counts.Iceland is exactly 2."],"semantic_requirements":["The bullets form a useful winter travel advisory semantically about visiting Reykjavik.","Topical relevance does not require the literal token Reykjavik because the task never requires that token."]}],"fail_criteria":["Fail if any binding instruction requirement is unsatisfied."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"],"notes":"The probe makes clear that Reykjavik relevance is semantic, not a hidden literal-token requirement."}
{"probe_id":"instr.multi_constraint_compliance.L2.003","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L2","axis_values":{"constraint_count":"7","constraint_types":"mixed_path_format_perm_content"},"prompt":"Write release notes for a fictional text editor v2.4. Constraints: (1) wrap the response in exactly one triple-backtick fenced code block with the language tag 'markdown'; (2) inside the fence, the first line is exactly '# v2.4'; (3) include exactly two level-2 headings, exactly '## Added' followed by exactly '## Fixed', with no other level-2 headings; (4) each subsection contains exactly two bullet lines, each beginning with '- '; (5) every bullet line ends with '.'; (6) the lowercase standalone word 'crash' appears exactly once in the fenced content; (7) the four bullet texts, counting whitespace-separated words after removing the '- ' prefixes and final periods, contain 50 to 100 words total. Output only the fenced block.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Write release notes for a fictional text editor v2.4. Constraints: (1) wrap the response in exactly one triple-backtick fenced code block with the language tag 'markdown'; (2) inside the fence, the first line is exactly '# v2.4'; (3) include exactly two level-2 headings, exactly '## Added' followed by exactly '## Fixed', with no other level-2 headings; (4) each subsection contains exactly two bullet lines, each beginning with '- '; (5) every bullet line ends with '.'; (6) the lowercase standalone word 'crash' appears exactly once in the fenced content; (7) the four bullet texts, counting whitespace-separated words after removing the '- ' prefixes and final periods, contain 50 to 100 words total. Output only the fenced block."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L2.004","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L2","axis_values":{"constraint_count":"8","constraint_types":"mixed_path_format_perm_content"},"prompt":"Compose a short menu description for a vegetarian restaurant. Output only the formatted menu. A word is any whitespace-separated token. For each numbered item, count all tokens on that item line, including its number, dish name, em dash, and description. For the total, count all whitespace-separated tokens in the entire response, including MENU. Constraints: (1) the response begins with the literal line 'MENU', (2) followed by one blank line, (3) followed by exactly four numbered items, beginning '1.' through '4.' on separate lines, (4) each item begins with an ALL-CAPS dish name followed by ' — ', (5) each item contains 12 to 25 words, (6) the standalone lowercase word 'organic' appears in at least two items, (7) no exclamation marks appear anywhere, and (8) the response contains 70 to 120 words total.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Compose a short menu description for a vegetarian restaurant. Output only the formatted menu. A word is any whitespace-separated token. For each numbered item, count all tokens on that item line, including its number, dish name, em dash, and description. For the total, count all whitespace-separated tokens in the entire response, including MENU. Constraints: (1) the response begins with the literal line 'MENU', (2) followed by one blank line, (3) followed by exactly four numbered items, beginning '1.' through '4.' on separate lines, (4) each item begins with an ALL-CAPS dish name followed by ' — ', (5) each item contains 12 to 25 words, (6) the standalone lowercase word 'organic' appears in at least two items, (7) no exclamation marks appear anywhere, and (8) the response contains 70 to 120 words total."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
{"probe_id": "instr.multi_constraint_compliance.L2.005", "canonical_id": "instr.multi_constraint_compliance", "category": "instr", "level": "L2", "axis_values": {"constraint_count": "9", "constraint_types": "mixed_path_format_perm_content"}, "prompt": "Write a short biography of a fictional astronomer named Lena Voss. Constraints: (1) exactly three paragraphs separated by a single blank line, (2) each paragraph contains exactly one sentence and ends with a period, (3) paragraph 1 begins with 'Born', (4) paragraph 2 begins with 'Her', (5) paragraph 3 begins with 'Today', (6) include the keyword 'telescope' at least once, (7) the response contains no semicolons, (8) the entire response contains between 60 and 110 whitespace-delimited words, inclusive, (9) the name 'Lena' appears exactly twice. Output only the biography.", "ground_truth": "format_only", "scorer": {"type": "format_check", "must_satisfy": [{"name": "three_para_one_sentence_each", "regex": "^Born [^.!?\\n]+\\.\\n\\nHer [^.!?\\n]+\\.\\n\\nToday(?:[ \\t]|,)[^.!?\\n]*\\.\\s*$"}, {"name": "has_telescope", "regex": "\\btelescope\\b"}, {"name": "no_semicolon", "regex": "^[^;]*$"}, {"name": "word_count_60_110", "regex": "^\\s*(?:\\S+\\s+){59,109}\\S+\\s*$"}, {"name": "lena_twice", "regex": "^(?:[^L]|L(?!ena))*Lena(?:[^L]|L(?!ena))*Lena(?:[^L]|L(?!ena))*$"}]}, "tags": ["unit_test_required"]}
{"probe_id":"instr.multi_constraint_compliance.L3.001","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L3","axis_values":{"constraint_count":"14","constraint_types":"mixed_path_format_perm_content"},"prompt":"Produce a structured incident report for a fictional power outage. All constraints are required, and any violation fails. Output only the report.\n\n1. The entire response must be exactly one <REPORT> block, with no text before or after it.\n2. <REPORT> must be followed immediately by a newline. The first line inside the block must be exactly '# Incident 2025-11-04'.\n3. After the title, include exactly these four Markdown headings, each exactly once and in this order: '## Summary', '## Timeline', '## Cause', and '## Resolution'. Do not include any other Markdown headings.\n4. Summary must contain exactly two sentences.\n5. Timeline must contain exactly four nonempty bullet lines. Every line must begin '- HH:MM ', where HH:MM is a valid 24-hour time. The four times must be strictly increasing.\n6. Cause must be exactly one paragraph containing two or three sentences.\n7. Resolution must be exactly one paragraph containing two or three sentences.\n8. The lowercase word 'transformer' must appear at least once in Cause and at least once in Resolution.\n9. Do not use '?' or '!'.\n10. Count whitespace-separated tokens in the entire response, including tags and headings. The total must be 140 through 220 tokens inclusive.\n11. The exact lowercase phrase 'root cause' must occur exactly once in the entire response, and it must occur in Cause.\n12. The exact lowercase phrase 'service restored' must occur exactly once in the entire response, and it must occur in Resolution.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Produce a structured incident report for a fictional power outage. All constraints are required, and any violation fails. Output only the report.\n\n1. The entire response must be exactly one <REPORT> block, with no text before or after it.\n2. <REPORT> must be followed immediately by a newline. The first line inside the block must be exactly '# Incident 2025-11-04'.\n3. After the title, include exactly these four Markdown headings, each exactly once and in this order: '## Summary', '## Timeline', '## Cause', and '## Resolution'. Do not include any other Markdown headings.\n4. Summary must contain exactly two sentences.\n5. Timeline must contain exactly four nonempty bullet lines. Every line must begin '- HH:MM ', where HH:MM is a valid 24-hour time. The four times must be strictly increasing.\n6. Cause must be exactly one paragraph containing two or three sentences.\n7. Resolution must be exactly one paragraph containing two or three sentences.\n8. The lowercase word 'transformer' must appear at least once in Cause and at least once in Resolution.\n9. Do not use '?' or '!'.\n10. Count whitespace-separated tokens in the entire response, including tags and headings. The total must be 140 through 220 tokens inclusive.\n11. The exact lowercase phrase 'root cause' must occur exactly once in the entire response, and it must occur in Cause.\n12. The exact lowercase phrase 'service restored' must occur exactly once in the entire response, and it must occur in Resolution."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required","high_difficulty"]}
{"probe_id":"instr.multi_constraint_compliance.L3.002","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L3","axis_values":{"constraint_count":"15","constraint_types":"mixed_path_format_perm_content"},"prompt":"Produce a fictional API changelog entry. Constraints (all required):\n(1) Wrap the entire response in a triple-backtick fence tagged 'yaml'.\n(2) Inside, top-level key 'version' is set to '3.7.0'.\n(3) Top-level key 'date' is set to '2025-12-09'.\n(4) Top-level key 'breaking' is a list of exactly two strings.\n(5) Top-level key 'added' is a list of exactly three strings.\n(6) Top-level key 'fixed' is a list of exactly two strings.\n(7) Keys appear in this exact order: version, date, breaking, added, fixed.\n(8) Every list item begins with a capital letter and ends with '.'.\n(9) Every list item contains 6 to 15 words, where words are maximal alphabetic sequences; YAML syntax, keys, version, date, and code fences do not count.\n(10) The standalone word 'endpoint' appears in at least one breaking item and at least one added item.\n(11) No list item contains the character ':'.\n(12) Across all list-item text, there are 90 to 170 words using the definition in constraint (9).\n(13) Do not use '!'.\n(14) Do not use '?'.\n(15) Use exactly two spaces before every list-item hyphen.\nOutput only the fenced YAML.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Produce a fictional API changelog entry. Constraints (all required):\n(1) Wrap the entire response in a triple-backtick fence tagged 'yaml'.\n(2) Inside, top-level key 'version' is set to '3.7.0'.\n(3) Top-level key 'date' is set to '2025-12-09'.\n(4) Top-level key 'breaking' is a list of exactly two strings.\n(5) Top-level key 'added' is a list of exactly three strings.\n(6) Top-level key 'fixed' is a list of exactly two strings.\n(7) Keys appear in this exact order: version, date, breaking, added, fixed.\n(8) Every list item begins with a capital letter and ends with '.'.\n(9) Every list item contains 6 to 15 words, where words are maximal alphabetic sequences; YAML syntax, keys, version, date, and code fences do not count.\n(10) The standalone word 'endpoint' appears in at least one breaking item and at least one added item.\n(11) No list item contains the character ':'.\n(12) Across all list-item text, there are 90 to 170 words using the definition in constraint (9).\n(13) Do not use '!'.\n(14) Do not use '?'.\n(15) Use exactly two spaces before every list-item hyphen.\nOutput only the fenced YAML."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required","high_difficulty"]}
{"probe_id":"instr.multi_constraint_compliance.L3.003","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L3","axis_values":{"constraint_count":"14","constraint_types":"mixed_path_format_perm_content"},"prompt":"Write a fictional museum exhibit guide. Constraints (all required):\n(1) the response begins with '# Exhibit Guide';\n(2) it contains exactly five sections and no other section headings, in this exact order: '## Origin', '## Materials', '## Symbolism', '## Provenance', '## Visit';\n(3) each section body contains exactly two nonempty sentences, with each sentence ending in '.';\n(4) the lowercase whole word 'bronze' appears at least once in Materials and at least once in Symbolism;\n(5) the lowercase whole word 'donated' appears exactly once in the entire response, and that occurrence is in Provenance;\n(6) Visit includes the literal phrase 'see Origin';\n(7) Symbolism includes the literal phrase 'see Materials';\n(8) the response contains no digits, semicolons, or exclamation marks;\n(9) the response contains no bullets or numbered lists;\n(10) the response is between 150 and 230 whitespace-separated tokens inclusive, counting headings;\n(11) the literal phrase 'curators believe' appears exactly once.\nOutput only the guide.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Write a fictional museum exhibit guide. Constraints (all required):\n(1) the response begins with '# Exhibit Guide';\n(2) it contains exactly five sections and no other section headings, in this exact order: '## Origin', '## Materials', '## Symbolism', '## Provenance', '## Visit';\n(3) each section body contains exactly two nonempty sentences, with each sentence ending in '.';\n(4) the lowercase whole word 'bronze' appears at least once in Materials and at least once in Symbolism;\n(5) the lowercase whole word 'donated' appears exactly once in the entire response, and that occurrence is in Provenance;\n(6) Visit includes the literal phrase 'see Origin';\n(7) Symbolism includes the literal phrase 'see Materials';\n(8) the response contains no digits, semicolons, or exclamation marks;\n(9) the response contains no bullets or numbered lists;\n(10) the response is between 150 and 230 whitespace-separated tokens inclusive, counting headings;\n(11) the literal phrase 'curators believe' appears exactly once.\nOutput only the guide."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required","high_difficulty"]}
{"probe_id":"instr.multi_constraint_compliance.L3.004","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L3","axis_values":{"constraint_count":"15","constraint_types":"mixed_path_format_perm_content"},"prompt":"Produce a fictional study protocol abstract. Output only the abstract. Constraints (all required):\n(1) Wrap the response exactly in <ABSTRACT>...</ABSTRACT>, with no text outside those tags.\n(2) Inside the tags, provide exactly four nonempty labelled paragraphs in this order: **Background:**, **Methods:**, **Results:**, **Conclusion:**. Each label must begin its own line.\n(3) Separate adjacent labelled paragraphs by exactly one blank line, with no other blank lines.\n(4) For word counts, count whitespace-separated tokens in paragraph body text only; do not count the Markdown label or the ABSTRACT tags. Background must contain 30-45 words, Methods 40-60 words, Results 30-50 words, and Conclusion 20-40 words.\n(5) The total number of body-text words across all four paragraphs must be 120-200.\n(6) The exact pattern n= followed immediately by a positive integer must appear exactly once in the entire response, and it must appear in Methods.\n(7) The exact pattern p< followed immediately by a decimal number must appear exactly once in the entire response, and it must appear in Results.\n(8) The exact phrase \"as described in Methods\" must appear in Conclusion.\n(9) The exact phrase \"consistent with Background\" must appear in Results.\n(10) The word \"placebo\" must appear exactly twice, case-sensitively, as a standalone word, and both occurrences must be in Methods.\n(11) Do not use exclamation marks or question marks.","ground_truth":"format_only","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Produce a fictional study protocol abstract. Output only the abstract. Constraints (all required):\n(1) Wrap the response exactly in <ABSTRACT>...</ABSTRACT>, with no text outside those tags.\n(2) Inside the tags, provide exactly four nonempty labelled paragraphs in this order: **Background:**, **Methods:**, **Results:**, **Conclusion:**. Each label must begin its own line.\n(3) Separate adjacent labelled paragraphs by exactly one blank line, with no other blank lines.\n(4) For word counts, count whitespace-separated tokens in paragraph body text only; do not count the Markdown label or the ABSTRACT tags. Background must contain 30-45 words, Methods 40-60 words, Results 30-50 words, and Conclusion 20-40 words.\n(5) The total number of body-text words across all four paragraphs must be 120-200.\n(6) The exact pattern n= followed immediately by a positive integer must appear exactly once in the entire response, and it must appear in Methods.\n(7) The exact pattern p< followed immediately by a decimal number must appear exactly once in the entire response, and it must appear in Results.\n(8) The exact phrase \"as described in Methods\" must appear in Conclusion.\n(9) The exact phrase \"consistent with Background\" must appear in Results.\n(10) The word \"placebo\" must appear exactly twice, case-sensitively, as a standalone word, and both occurrences must be in Methods.\n(11) Do not use exclamation marks or question marks."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required","high_difficulty"]}
{"probe_id":"instr.multi_constraint_compliance.L3.005","canonical_id":"instr.multi_constraint_compliance","category":"instr","level":"L3","axis_values":{"constraint_count":"16","constraint_types":"mixed_path_format_perm_content"},"prompt":"Produce a fictional course syllabus snippet. Output only one triple-backtick fence tagged json, with no text before or after it. The fenced content must be valid JSON, pretty-printed using exactly 2 spaces per indentation level. Count words as non-empty whitespace-delimited tokens in the complete response, including fence lines; the count must be 200 through 380 inclusive. No JSON string value may contain the double-quote character U+0022 (therefore do not use an escaped \\\" inside any value). The top-level object must have exactly these keys in exactly this order: code, title, instructor, week_count, weeks, policies. code must match ^[A-Z]{2,4}-\\d{3}$. title must contain the portion of code after the dash. week_count must be the integer 8. weeks must be an array of exactly 8 objects. Each week object must have exactly the keys index, topic, reading. The index values must be the integers 1 through 8 in strictly increasing order. Each topic must be a non-empty string containing 3 through 10 whitespace-delimited words. Each reading must be a non-empty string ending in a four-digit year in parentheses. policies must be an object with exactly the keys late_work and attendance. late_work must contain the literal substring within 48 hours. attendance must contain the literal substring no more than 2 absences.","ground_truth":"format_only; accept any output that passes all specified syntactic and semantic validations.","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["Pass only if the response satisfies every content, formatting, counting, ordering, casing, preservation, and output-only constraint stated in this task. Treat literal/exact/verbatim requirements strictly. Task: Produce a fictional course syllabus snippet. Output only one triple-backtick fence tagged json, with no text before or after it. The fenced content must be valid JSON, pretty-printed using exactly 2 spaces per indentation level. Count words as non-empty whitespace-delimited tokens in the complete response, including fence lines; the count must be 200 through 380 inclusive. No JSON string value may contain the double-quote character U+0022 (therefore do not use an escaped \\\" inside any value). The top-level object must have exactly these keys in exactly this order: code, title, instructor, week_count, weeks, policies. code must match ^[A-Z]{2,4}-\\d{3}$. title must contain the portion of code after the dash. week_count must be the integer 8. weeks must be an array of exactly 8 objects. Each week object must have exactly the keys index, topic, reading. The index values must be the integers 1 through 8 in strictly increasing order. Each topic must be a non-empty string containing 3 through 10 whitespace-delimited words. Each reading must be a non-empty string ending in a four-digit year in parentheses. policies must be an object with exactly the keys late_work and attendance. late_work must contain the literal substring within 48 hours. attendance must contain the literal substring no more than 2 absences."],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required","high_difficulty"]}
