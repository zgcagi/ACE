{"probe_id":"instr.literal_verbatim_emission.L1.002","canonical_id":"instr.literal_verbatim_emission","category":"instr","level":"L1","axis_values":{"literal_position":"terminal_anchor","string_length":"short_token"},"prompt":"Write exactly two lines and nothing else. The first line must be one sentence about lighthouses and must contain the whole word \"lighthouses\"; matching that word is case-insensitive, so sentence-initial \"Lighthouses\" is allowed. The second line must be exactly the three-character marker \"***\".","ground_truth":{"line_count":2,"line_1":"One complete sentence about lighthouses containing the case-insensitive whole word lighthouses.","line_2":"***","extra_content_allowed":false},"scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"two_line_literal_contract","requirements":["There must be exactly two nonempty output lines and no other content.","Line 1 must be one complete sentence about lighthouses and contain the case-insensitive whole word lighthouses; Lighthouses at sentence start is explicitly valid.","Line 2 must be exactly *** with no spaces or other characters."],"accepted_examples":["Lighthouses guide ships safely through darkness and storms.\n***","Old lighthouses still warn sailors away from reefs.\n***"],"rejected_examples":["Beacons guide ships safely.\n***","Lighthouses guide ships safely.\n****"]}],"fail_criteria":["Fail if the line count is not two, the first line lacks the case-insensitive whole word lighthouses or is not a sentence about lighthouses, the second line is not exactly ***, or any extra content appears."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":[]}
