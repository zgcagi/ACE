{"probe_id":"instr.keyword_frequency_constraint.L3.005","canonical_id":"instr.keyword_frequency_constraint","category":"instr","level":"L3","axis_values":{"relation":"exact","unit_predicate":"delimited_span"},"prompt":"Write an 80–120-word product blurb for a fountain pen. Exactly two non-whitespace tokens must each be enclosed by a single opening and closing asterisk (for example, *ink*). Do not use any other asterisks. Output only the blurb.","ground_truth":"format_only","scorer":{"type":"format_check","must_satisfy":[{"name":"wc_80_120","regex":"^(?:\\s*\\S+){80,120}\\s*$"},{"name":"exactly_two_single_token_highlighted_spans_no_other_asterisks","regex":"^(?=(?:[^*]*\\*[^*\\s\\n]+\\*){2}[^*]*$)(?:.|\\n)*$"}]},"tags":["instruction_following","keyword_frequency_constraint"]}
