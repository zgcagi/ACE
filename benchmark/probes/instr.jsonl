{"probe_id":"instr.length_constraint.L3.001","canonical_id":"instr.length_constraint","category":"instr","level":"L3","axis_values":{"unit":"paragraph_with_separator","relation":"exact","magnitude":"medium"},"prompt":"Write exactly 4 non-empty paragraphs about the history of the printing press. Separate consecutive paragraphs with a line containing exactly `###`. Do not use `###` anywhere else. Each paragraph must contain at least one complete sentence. Purely blank lines immediately before or after a `###` divider are permitted and ignored; they do not create extra paragraphs or extra content. Output only the four paragraphs, the three divider lines, and any such optional blank lines.","ground_truth":{"type":"format_and_content_constraints","paragraph_count":4,"divider":"###","divider_count":3,"topic":"history of the printing press","sentence_requirement":"Each paragraph contains at least one complete sentence.","whitespace_policy":"Normalize line endings, ignore outer blank lines, and trim blank lines adjacent to each divider before identifying the four nonempty paragraphs."},"scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"paragraph_divider_contract","requirements":["After normalizing line endings and ignoring outer whitespace, exactly three lines must contain only ###.","Split at those divider lines, trim whitespace including optional adjacent blank lines from each segment, and require exactly four nonempty paragraphs.","Each paragraph must contain at least one complete sentence and substantively concern the history of the printing press.","No commentary or nonblank content may appear outside the four paragraphs and three dividers.","Do not fail merely because a permitted blank line appears immediately before or after a divider."],"accepted_format_examples":["Paragraph one.\n###\nParagraph two.\n###\nParagraph three.\n###\nParagraph four.","Paragraph one.\n\n###\nParagraph two.\n\n###\nParagraph three.\n\n###\nParagraph four."],"rejected_format_examples":["Paragraph one.\n##\nParagraph two.\n###\nParagraph three.\n###\nParagraph four.","Paragraph one.\n###\nParagraph two.\n###\nParagraph three."]}],"fail_criteria":["Fail if there are not exactly four substantive nonempty printing-press-history paragraphs and exactly three ### divider lines, if any paragraph lacks a complete sentence, or if nonblank extra content appears."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["unit_test_required"]}
