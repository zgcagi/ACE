// probes/meta.jsonl — category=meta, atoms=6, probes=90 (5 per level x 3 levels x 6 atoms)
// Generated 2026-06-01. Atoms: self_verification, self_audit, error_detection, plan_revision, uncertainty_communication, ambiguity_detection.
// Scorer types used: exact_match_string, regex, mcq_letter.
//
// Post-review fixes applied (after Explore subagent critique):
//   * meta.ambiguity_detection: replaced 4 of 15 with disambiguated foils (gender, number, semantic constraint)
//     so models cannot trivially pass by always emitting "ambiguous". Distribution now 11 ambiguous + 4 foils.
//   * meta.uncertainty_communication L1.001-L1.005: replaced loose substring_any scorers with regex
//     requiring BOTH a digit AND a strong caveat marker not present in the prompt.
//   * meta.uncertainty_communication L2.002 / L3.003 / L3.005: tightened range regexes to require
//     the precise propagated bounds (not bare integers that drop the fractional part).
//   * meta.uncertainty_communication L2.005: replaced multiplicative range probe with subtraction
//     (cash remaining after lunch) to test non-monotone propagation direction.
//   * meta.self_audit.L2.002: clarified Vieta-identity lines so first error is unambiguously line 5.
//   * meta.self_audit.L3.003: reordered so "pairwise product" is defined before its first use; first
//     error is now line 9 (1+4+9=14, not 15). Tag corrected to arithmetic_slip.
//   * meta.self_audit.L3.005: marked high-precision constants as "(from a table)" so auditor only
//     verifies elementary arithmetic, not heavy compound-interest computation.
//   * meta.error_detection.L1.005: clarified prompt to "exit successfully without errors" (treats
//     warnings as non-fatal) to remove debate over warnings-as-failure.
//   * meta.error_detection.L3.002: replaced duplicate sort-list domain with word-count off-by-one.
//
// Declined fixes (with rationale):
//   * meta.plan_revision.L1: kept all-persist answers because the atom card explicitly says
//     L1 plans are "almost never required" to revise. Discrimination comes from L2/L3 contrast.
//   * meta.ambiguity_detection.L3: kept all 5 ambiguous (atom card states "correct call is still
//     'ambiguous'" for L3) — the L1/L2 foils are sufficient to break the constant-output exploit.
//   * meta.self_audit.L1: kept strict regex on line numbers; output instruction is explicit
//     ("Reply with only the integer line number"), so non-compliant verbose answers should fail.
//   * meta.self_audit.L3.002: kept the circumradius formula audit; formula recall is part of
//     normal mathematical self-audit and the failure (150/48 = 3.125) is checkable by long division.
{"probe_id":"meta.self_verification.L1.001","canonical_id":"meta.self_verification","category":"meta","level":"L1","axis_values":{"verifiability":"trivial_visible"},"prompt":"Task given to an agent: \"Add a row labeled 'Total' at the bottom of the table whose value equals the sum of column B.\"\n\nFinal spreadsheet state:\n| Apples | 10 |\n| Pears  | 15 |\n| Plums  | 5  |\n| Total  | 30 |\n\nHas the task been completed correctly? Reply with exactly 'yes' or 'no'.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true},"tags":["self_verification","visible_predicate"],"notes":"sum 10+15+5=30, matches"}
{"probe_id":"meta.self_verification.L1.002","canonical_id":"meta.self_verification","category":"meta","level":"L1","axis_values":{"verifiability":"trivial_visible"},"prompt":"Task: rename the file 'old_notes.txt' to 'meeting.txt' in the current directory. Assume no other file operations occurred after this rename attempt. A successful rename requires 'meeting.txt' to exist and 'old_notes.txt' to no longer exist.\n\nAfter the attempt, `ls` reports:\n  archive/  meeting.txt  old_notes.txt  README.md\n\nHas the task been completed correctly? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["self_verification","visible_predicate"],"notes":"old file still present, rename did not happen"}
{"probe_id":"meta.self_verification.L1.003","canonical_id":"meta.self_verification","category":"meta","level":"L1","axis_values":{"verifiability":"trivial_visible"},"prompt":"Task: make cell C1 display the value 42.\n\nVisible spreadsheet:\n  A1: foo   B1: bar   C1: 24\n\nHas the task been completed? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","visible_predicate"],"notes":"C1 holds 24 not 42"}
{"probe_id":"meta.self_verification.L1.004","canonical_id":"meta.self_verification","category":"meta","level":"L1","axis_values":{"verifiability":"trivial_visible"},"prompt":"Task: create a directory named 'logs' inside /home/user/project.\n\nAfter the action, `ls /home/user/project` reports:\n  bin/  logs/  src/  README.md\n\nHas the task been completed? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","visible_predicate"],"notes":""}
{"probe_id":"meta.self_verification.L1.005","canonical_id":"meta.self_verification","category":"meta","level":"L1","axis_values":{"verifiability":"trivial_visible"},"prompt":"Task: change the slide background colour to blue on slide 3.\n\nThe slide-thumbnail panel shows:\n  Slide 1: white background\n  Slide 2: white background\n  Slide 3: green background\n  Slide 4: white background\n\nHas the task been completed? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","visible_predicate"],"notes":"green != blue"}
{"probe_id":"meta.self_verification.L2.001","canonical_id":"meta.self_verification","category":"meta","level":"L2","axis_values":{"verifiability":"requires_extra_action"},"prompt":"Task: place the sum of B2:B7 in cell B8.\n\nVisible cells:\n  B2=22, B3=18, B4=31, B5=44, B6=12, B7=15\n  B8=142\n\nHas the task been completed correctly? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","aggregate_check"],"notes":"22+18+31+44+12+15=142"}
{"probe_id":"meta.self_verification.L2.002","canonical_id":"meta.self_verification","category":"meta","level":"L2","axis_values":{"verifiability":"requires_extra_action"},"prompt":"Task: send an email to sam@example.org with subject 'Update'.\n\nThe Sent folder lists exactly one new entry:\n  To: sam@example.org\n  Subject: 'Updated'\n  Sent: today 10:14\n\nHas the task been completed correctly? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","near_match"],"notes":"subject Updated != Update"}
{"probe_id":"meta.self_verification.L2.003","canonical_id":"meta.self_verification","category":"meta","level":"L2","axis_values":{"verifiability":"requires_extra_action"},"prompt":"Task: set the user's password to a value of at least 12 characters.\n\nThe action set the password to 'Tr0ub4dor'.\n\nHas the task been completed? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","constraint_check"],"notes":"Tr0ub4dor is 9 characters"}
{"probe_id":"meta.self_verification.L2.004","canonical_id":"meta.self_verification","category":"meta","level":"L2","axis_values":{"verifiability":"requires_extra_action"},"prompt":"Task: write only files larger than 1 MB from /tmp into report.txt, one filename per line.\n\nAfter the action, `cat report.txt` shows:\n  big.iso  4.2 MB\n  huge.bin 3.1 MB\n  small.log 0.5 MB\n\nHas the task been completed correctly? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true},"tags":["self_verification","filter_check"],"notes":"small.log is 0.5MB so should be excluded"}
{"probe_id":"meta.self_verification.L2.005","canonical_id":"meta.self_verification","category":"meta","level":"L2","axis_values":{"verifiability":"requires_extra_action"},"prompt":"Task: determine whether an image has been resized to exactly 800x600 pixels.\n\nThe image properties dialog reads:\n  Width: 800 px\n  Height: 480 px\n\nHas the task been completed? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["self_verification","dimension_check"],"notes":""}
{"probe_id":"meta.self_verification.L3.001","canonical_id":"meta.self_verification","category":"meta","level":"L3","axis_values":{"verifiability":"requires_external_tool"},"prompt":"An agent was given the task: \"Generate report.pdf from report.md and ensure it opens correctly in a PDF viewer.\"\n\nThe agent ran:\n  pandoc report.md -o report.pdf\nand received exit code 0. The agent then says \"Done.\"\n\nDid the agent properly verify completion of the goal predicate? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","external_check_missing"],"notes":"verifying 'opens correctly in viewer' requires opening it"}
{"probe_id":"meta.self_verification.L3.002","canonical_id":"meta.self_verification","category":"meta","level":"L3","axis_values":{"verifiability":"provided_execution_record"},"prompt":"An agent was given the task: \"Build the project and confirm the test suite passes.\"\n\nThe agent ran `make build`, which printed \"Build OK\". The agent then says \"Done.\"\n\nDid the agent properly verify completion of the goal predicate? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["self_verification","external_check_missing"],"notes":"tests never run"}
{"probe_id":"meta.self_verification.L3.003","canonical_id":"meta.self_verification","category":"meta","level":"L3","axis_values":{"verifiability":"requires_external_tool"},"prompt":"An agent was given the task: \"Add the daily cron entry `0 2 * * * root /usr/local/bin/backup` to /etc/crontab and confirm that the cron service is running.\"\n\nThe agent added that exact line to /etc/crontab, ran `grep -Fx '0 2 * * * root /usr/local/bin/backup' /etc/crontab` and obtained a match, then ran `systemctl is-active --quiet cron` and it exited with status 0. The agent then says \"Done.\"\n\nDid the agent properly verify completion of the stated goal? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","external_check_done"],"notes":"verification step was executed"}
{"probe_id":"meta.self_verification.L3.004","canonical_id":"meta.self_verification","category":"meta","level":"L3","axis_values":{"verifiability":"requires_external_tool"},"prompt":"An agent was given the task: \"Deploy the web service and verify the endpoint is responding with HTTP 200.\"\n\nThe agent ran `kubectl apply -f deploy.yaml`, which printed \"deployment.apps/web created\", then ran `curl -s -o /dev/null -w '%{http_code}' https://web.example/health` which returned `200`. The agent then says \"Done.\"\n\nDid the agent properly verify completion of the goal predicate? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["self_verification","external_check_done"],"notes":"endpoint verified with curl"}
{"probe_id":"meta.self_verification.L3.005","canonical_id":"meta.self_verification","category":"meta","level":"L3","axis_values":{"verifiability":"requires_external_tool"},"prompt":"An agent was given the task: \"Deploy a new SSH key on host alpha and verify that login works using the new key.\"\n\nThe agent generated a new keypair and copied the new public key into ~/.ssh/authorized_keys. The agent did not attempt any SSH login using the new private key, then said \"Done.\"\n\nDid the agent properly verify completion of the goal predicate? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["self_verification","external_check_missing"],"notes":"login never tested"}
{"probe_id":"meta.self_audit.L1.001","canonical_id":"meta.self_audit","category":"meta","level":"L1","axis_values":{"audit_target":"arithmetic_slip","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. 7 x 8 = 56\n2. 56 + 4 = 60\n3. 60 / 5 = 12","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\s*$","flags":["i"]},"tags":["self_audit","short_chain"]}
{"probe_id":"meta.self_audit.L1.002","canonical_id":"meta.self_audit","category":"meta","level":"L1","axis_values":{"audit_target":"arithmetic_slip","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. (3 + 4)^2 = 49\n2. 49 - 10 = 39\n3. 39 / 3 = 14","ground_truth":"3","scorer":{"type":"regex","pattern":"^\\s*3\\s*$","flags":[]},"tags":["self_audit","short_chain"],"notes":"39/3 = 13 not 14"}
{"probe_id":"meta.self_audit.L1.003","canonical_id":"meta.self_audit","category":"meta","level":"L1","axis_values":{"audit_target":"no_error_check","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Let x = 5.\n2. 2x + 3 = 13.\n3. x^2 = 25.\n4. 2x^2 + 3 = 53.","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\s*$","flags":["i"]},"tags":["self_audit","short_chain"],"notes":""}
{"probe_id":"meta.self_audit.L1.004","canonical_id":"meta.self_audit","category":"meta","level":"L1","axis_values":{"audit_target":"arithmetic_slip","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. distance = speed × time = 60 km/h × 2 h = 120 km\n2. fuel used = distance / fuel efficiency = 120 km / (30 km/L) = 4 L\n3. cost = fuel used × price = 4 L × 1.50 per L = 5.00","ground_truth":"3","scorer":{"type":"regex","pattern":"^\\s*3\\s*$","flags":[]},"tags":["self_audit","short_chain"],"notes":"4*1.5=6.00 not 5.00"}
{"probe_id":"meta.self_audit.L1.005","canonical_id":"meta.self_audit","category":"meta","level":"L1","axis_values":{"audit_target":"arithmetic_slip","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. perimeter = 2(L+W) = 2(8+5) = 26\n2. area = L*W = 8*5 = 45\n3. diagonal^2 = L^2 + W^2 = 64 + 25 = 89","ground_truth":"2","scorer":{"type":"regex","pattern":"^\\s*2\\s*$","flags":[]},"tags":["self_audit","short_chain"],"notes":"8*5=40 not 45"}
{"probe_id":"meta.self_audit.L2.001","canonical_id":"meta.self_audit","category":"meta","level":"L2","axis_values":{"audit_target":"substitution_error","chain_length":"medium"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Let f(x) = x^2 - 4.\n2. f(3) = 9 - 4 = 5.\n3. f(2) = 4 - 4 = 0.\n4. f(3) - f(2) = 5 - 0 = 5.\n5. f(4) - f(3) = (16 - 4) - 5 = 7.","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\s*$","flags":["i"]},"tags":["self_audit","medium_chain"],"notes":""}
{"probe_id":"meta.self_audit.L2.002","canonical_id":"meta.self_audit","category":"meta","level":"L2","axis_values":{"audit_target":"step_omission","chain_length":"medium"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\nGoal: solve 2x^2 + 3x + 5 = 0 over the real numbers.\n1. a=2, b=3, c=5.\n2. Discriminant D = b^2 - 4ac = 9 - 40 = -31.\n3. (Vieta's identities, which hold formally regardless of D's sign): sum of roots = -b/a = -3/2.\n4. (Vieta's identities, which hold formally regardless of D's sign): product of roots = c/a = 5/2.\n5. Therefore the equation has two real roots whose sum is -3/2 and product is 5/2.","ground_truth":"5","scorer":{"type":"regex","pattern":"^\\s*5\\s*$","flags":[]},"tags":["self_audit","medium_chain"],"notes":"Vieta lines explicitly note formal validity for complex roots, so line 5 is the unique first error"}
{"probe_id":"meta.self_audit.L2.003","canonical_id":"meta.self_audit","category":"meta","level":"L2","axis_values":{"audit_target":"substitution_error","chain_length":"medium"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Substitute x = 4 into y = 2x - 3: y = 2(4) - 3 = 5.\n2. Substitute x = -2 into y = 2x - 3: y = 2(-2) - 3 = -7.\n3. Slope between (4, 5) and (-2, -7) = (5 - (-7)) / (4 - (-2)) = 12 / 6 = 2.\n4. y-intercept = y - mx = 5 - 2(4) = -3.\n5. Final line equation: y = 2x - 3.","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\s*$","flags":["i"]},"tags":["self_audit","medium_chain"],"notes":""}
{"probe_id":"meta.self_audit.L2.004","canonical_id":"meta.self_audit","category":"meta","level":"L2","axis_values":{"audit_target":"arithmetic_slip","chain_length":"medium"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Solve 3x + 7 = 22.\n2. 3x = 22 - 7 = 15.\n3. x = 5.\n4. Check: 3(5) + 7 = 22. ok.\n5. Now solve 3x + 7 = 25.\n6. 3x = 25 + 7 = 32.\n7. x = 32/3.","ground_truth":"6","scorer":{"type":"regex","pattern":"^\\s*6\\s*$","flags":[]},"tags":["self_audit","medium_chain"],"notes":"sign flip; 25-7=18 not 25+7=32"}
{"probe_id":"meta.self_audit.L2.005","canonical_id":"meta.self_audit","category":"meta","level":"L2","axis_values":{"audit_target":"arithmetic_slip","chain_length":"medium"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Subtotal = 12 items * $4.50 = $54.00.\n2. Tax = 54.00 * 0.08 = $4.32.\n3. Subtotal-with-tax = 54.00 + 4.32 = $58.32.\n4. Tip = 54.00 * 0.15 = $8.10.\n5. Total = 58.32 + 8.10 = $67.42.","ground_truth":"5","scorer":{"type":"regex","pattern":"^\\s*5\\s*$","flags":[]},"tags":["self_audit","medium_chain"],"notes":"58.32 + 8.10 = 66.42 not 67.42"}
{"probe_id":"meta.self_audit.L3.001","canonical_id":"meta.self_audit","category":"meta","level":"L3","axis_values":{"audit_target":"arithmetic_slip","chain_length":"long"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Sequence a_n = 3n + 2 for n >= 1.\n2. a_1 = 5.\n3. a_2 = 8.\n4. a_3 = 11.\n5. a_4 = 14.\n6. a_5 = 17.\n7. a_6 = 20.\n8. Sum a_1..a_6 = 5+8+11+14+17+20.\n9. Pairing first/last: (5+20)+(8+17)+(11+14) = 25+25+25 = 75.\n10. Average = 75/6 = 12.5.\n11. Common difference d = a_2 - a_1 = 3.\n12. Closed form S = n(a_1+a_n)/2 = 6(5+20)/2 = 75. Matches step 9.","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\.?\\s*$","flags":["i"]},"tags":["self_audit","long_chain"],"notes":""}
{"probe_id":"meta.self_audit.L3.002","canonical_id":"meta.self_audit","category":"meta","level":"L3","axis_values":{"audit_target":"arithmetic_slip","chain_length":"long"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Triangle ABC with A(0,0), B(6,0), C(3,4).\n2. AB length = 6.\n3. AC length = sqrt(9+16) = 5.\n4. BC length = sqrt((6-3)^2 + (0-4)^2) = sqrt(9+16) = 5.\n5. Perimeter = 6 + 5 + 5 = 16.\n6. Area = (1/2) * 6 * 4 = 12.\n7. Semi-perimeter s = 16/2 = 8.\n8. Heron: sqrt(8*2*3*3) = sqrt(144) = 12. Matches step 6.\n9. Inradius r = Area/s = 12/8 = 1.5.\n10. Circumradius R = abc/(4*Area) = (6*5*5)/(4*12) = 150/48 = 3.0.","ground_truth":"10","scorer":{"type":"regex","pattern":"^\\s*10\\s*$","flags":[]},"tags":["self_audit","long_chain"],"notes":"150/48 = 3.125 not 3.0"}
{"probe_id":"meta.self_audit.L3.003","canonical_id":"meta.self_audit","category":"meta","level":"L3","axis_values":{"audit_target":"arithmetic_slip","chain_length":"long"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Solve x^3 - 6x^2 + 11x - 6 = 0.\n2. Try x = 1: 1 - 6 + 11 - 6 = 0. So (x-1) is a factor.\n3. Polynomial division gives x^2 - 5x + 6.\n4. Factor: (x-2)(x-3).\n5. Roots: x = 1, 2, 3.\n6. Sum of roots = 1+2+3 = 6.\n7. Product of roots = 1*2*3 = 6.\n8. Pairwise product = 1*2 + 1*3 + 2*3 = 11.\n9. Sum of squares = 1+4+9 = 15.\n10. By Newton's identity: p_2 = (sum)^2 - 2(pairwise product) = 36 - 2*11 = 14.","ground_truth":"9","scorer":{"type":"regex","pattern":"^\\s*9\\s*$","flags":[]},"tags":["self_audit","long_chain"],"notes":"reordered so pairwise product is defined before use; first error is line 9 (1+4+9=14, not 15)"}
{"probe_id":"meta.self_audit.L3.004","canonical_id":"meta.self_audit","category":"meta","level":"L3","axis_values":{"audit_target":"arithmetic_slip","chain_length":"short"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step.\n\n1. Bag has 5 red, 3 blue, 2 green marbles. Total 10.\n2. P(red) = 5/10 = 1/2.\n3. P(blue) = 3/10.\n4. P(green) = 2/10 = 1/5.\n5. Draw 2 without replacement. P(both red) = (5/10)(4/9) = 2/9.\n6. P(both blue) = (3/10)(2/9) = 1/15.\n7. P(both green) = (2/10)(1/9) = 1/45.\n8. P(both same colour) = 2/9 + 1/15 + 1/45 = 10/45 + 3/45 + 1/45 = 14/45.\n9. P(different colours) = 1 - 14/45 = 21/45.\n10. Expected number of red in 2 draws = 2 * (5/10) = 1.","ground_truth":"9","scorer":{"type":"regex","pattern":"^\\s*9\\s*$","flags":[]},"tags":["self_audit","long_chain"],"notes":"1 - 14/45 = 31/45 not 21/45"}
{"probe_id":"meta.self_audit.L3.005","canonical_id":"meta.self_audit","category":"meta","level":"L3","axis_values":{"audit_target":"substitution_error","chain_length":"long"},"prompt":"Audit the derivation below. If every step is correct, reply with the single word 'correct'. Otherwise reply with only the integer line number of the first incorrect step. You may treat any value labelled '(from a table)' as given and not subject to audit.\n\n1. Compound interest formula: A = P(1 + r/n)^(nt).\n2. Principal P = 1000, annual rate r = 0.06, compounded n = 4, time t = 5 years.\n3. n*t = 20.\n4. r/n = 0.015.\n5. (1.015)^20 = 1.34686 (from a table).\n6. A = 1000 * 1.34686 = 1346.86.\n7. Interest earned = A - P = 346.86.\n8. Simple interest comparison: I = P*r*t = 1000*0.06*5 = 300.\n9. Compound advantage over simple = 346.86 - 300 = 46.86.\n10. Continuous limit: A_inf = P*e^(rt) = 1000 * e^0.30 = 1000 * 1.34986 = 1349.86 (using e^0.30 from a table).\n11. So continuous compounding gives about $3.00 more than quarterly.","ground_truth":"correct","scorer":{"type":"regex","pattern":"^\\s*correct\\s*$","flags":["i"]},"tags":["self_audit","long_chain"],"notes":"high-precision values labelled '(from a table)' so auditor only checks elementary arithmetic"}
{"probe_id":"meta.error_detection.L1.001","canonical_id":"meta.error_detection","category":"meta","level":"L1","axis_values":{"failure_signal":"explicit_error","self_vs_environment":"env_signaled"},"prompt":"A user ran `python script.py`. The complete output was:\n\nLoading data...\nTraceback (most recent call last):\n  File \"script.py\", line 12, in <module>\n    df['col'] = df['cl']\nKeyError: 'cl'\n\nDid the script complete successfully? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_error"],"notes":""}
{"probe_id":"meta.error_detection.L1.002","canonical_id":"meta.error_detection","category":"meta","level":"L1","axis_values":{"failure_signal":"explicit_error","self_vs_environment":"env_signaled"},"prompt":"After running `make`, the terminal showed:\n\ngcc -o app main.c utils.c\nmain.c:42: error: 'undefined_func' undeclared\nmake: *** [app] Error 1\n\nDid the build succeed? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_error"],"notes":""}
{"probe_id":"meta.error_detection.L1.003","canonical_id":"meta.error_detection","category":"meta","level":"L1","axis_values":{"failure_signal":"explicit_error","self_vs_environment":"env_signaled"},"prompt":"A deploy script produced this output:\n\n[INFO] Pushing image...\n[INFO] Image pushed: registry/app:v1.2\n[INFO] Updating deployment...\n[INFO] Done.\nExit code: 0\n\nBased only on this output, did the deploy script report success? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_error"],"notes":""}
{"probe_id":"meta.error_detection.L1.004","canonical_id":"meta.error_detection","category":"meta","level":"L1","axis_values":{"failure_signal":"explicit_error","self_vs_environment":"env_signaled"},"prompt":"Output of `pytest`:\n\ncollected 12 items\ntests/test_a.py ........\ntests/test_b.py FFFF\n=================== 4 failed, 8 passed in 1.23s ===================\n\nDid the test suite pass? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_error"],"notes":""}
{"probe_id":"meta.error_detection.L1.005","canonical_id":"meta.error_detection","category":"meta","level":"L1","axis_values":{"failure_signal":"explicit_error","self_vs_environment":"env_signaled"},"prompt":"Output of `npm install`:\n\nnpm warn deprecated package@1.0.0: please upgrade\nadded 142 packages in 18s\n\nDid the install command exit successfully (i.e. complete without errors)? Treat warnings as non-fatal. Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_error"],"notes":"prompt clarified: warnings are non-fatal, only errors count as failure"}
{"probe_id":"meta.error_detection.L2.001","canonical_id":"meta.error_detection","category":"meta","level":"L2","axis_values":{"failure_signal":"silent_metric_drop","self_vs_environment":"metric_only"},"prompt":"Validation accuracy on this dataset has been 0.92 in every previous run. After a refactor, the latest run reports validation accuracy 0.07. Training loss is decreasing as expected and there are no errors in the log. Should this result be flagged as a problem? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","silent_drop"],"notes":""}
{"probe_id":"meta.error_detection.L2.002","canonical_id":"meta.error_detection","category":"meta","level":"L2","axis_values":{"failure_signal":"silent_metric_drop","self_vs_environment":"metric_only"},"prompt":"Yesterday's nightly job processed 4,820,318 records. Today's run processed 4,791,206 records. The monitoring policy flags a problem only when the absolute day-over-day change exceeds 1.0%. Based only on this policy, should today's count be flagged as a problem? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","within_drift"],"notes":"~0.6 percent drift, within normal variance"}
{"probe_id":"meta.error_detection.L2.003","canonical_id":"meta.error_detection","category":"meta","level":"L2","axis_values":{"failure_signal":"explicit_wrong_output","self_vs_environment":"observed_mismatch"},"prompt":"A regression test asserts that f(2, 3) returns 6. The latest CI run reports: \"f(2, 3) returned -2147483642.\" Should this be flagged as a problem? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["error_detection","explicit_mismatch"],"notes":"The observed value conflicts with the stated expected value; the prompt does not establish the underlying cause."}
{"probe_id":"meta.error_detection.L2.004","canonical_id":"meta.error_detection","category":"meta","level":"L2","axis_values":{"failure_signal":"silent_metric_drop","self_vs_environment":"metric_only"},"prompt":"A monitoring system reports daily revenue:\n\nMon: $42,100\nTue: $41,800\nWed: $42,500\nThu: $0\nFri: $43,000\n\nBased on these values, should Thursday be flagged as an anomaly for investigation? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"regex","pattern":"^\\s*yes[.。]?\\s*$","flags":["i"]},"tags":["error_detection","silent_drop"],"notes":""}
{"probe_id":"meta.error_detection.L2.005","canonical_id":"meta.error_detection","category":"meta","level":"L2","axis_values":{"failure_signal":"silent_metric_drop","self_vs_environment":"metric_only"},"prompt":"Training loss values across epochs: 0.512, 0.421, 0.350, 0.301, NaN, NaN, NaN. Should the training run be flagged as a problem? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","silent_drop"],"notes":"NaN loss"}
{"probe_id":"meta.error_detection.L3.001","canonical_id":"meta.error_detection","category":"meta","level":"L3","axis_values":{"failure_signal":"explicit_order_violation","self_vs_environment":"no_signal"},"prompt":"Task: sort the list [3, 1, 4, 1, 5, 9, 2, 6] in ascending order.\nFunction output: [1, 1, 2, 3, 4, 5, 6, 9]\n\nShould this output be flagged as incorrect? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["error_detection","order_check"],"notes":""}
{"probe_id":"meta.error_detection.L3.002","canonical_id":"meta.error_detection","category":"meta","level":"L3","axis_values":{"failure_signal":"subtle_correctness","self_vs_environment":"no_signal"},"prompt":"Task: count the number of words in the sentence \"the quick brown fox jumps over the lazy dog\".\nFunction returned: 8.\n\nShould this output be flagged as incorrect? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","subtle"],"notes":"sentence has 9 words; off-by-one error"}
{"probe_id":"meta.error_detection.L3.003","canonical_id":"meta.error_detection","category":"meta","level":"L3","axis_values":{"failure_signal":"subtle_correctness","self_vs_environment":"no_signal"},"prompt":"An evaluation script must score model outputs on factual accuracy from 0.0 to 1.0. After a recent refactor, the script returns 1.0 for every example, including obvious nonsense. The aggregate score on the metric improved from 0.61 to 1.00. Should this be flagged as a problem? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","subtle","score_gaming"],"notes":""}
{"probe_id":"meta.error_detection.L3.004","canonical_id":"meta.error_detection","category":"meta","level":"L3","axis_values":{"failure_signal":"explicit_duplicate_after_normalization","self_vs_environment":"no_signal"},"prompt":"Spec: deduplicate emails using case-insensitive comparison.\nInput: [\"a@x.com\", \"B@x.com\", \"a@X.COM\", \"c@y.com\"]\nFunction output: [\"a@x.com\", \"B@x.com\", \"a@X.COM\", \"c@y.com\"]\n\nShould the output be flagged as incorrect? Reply 'yes' or 'no' only.","ground_truth":"yes","scorer":{"type":"exact_match_string","expected":"yes","case_sensitive":false,"strip_whitespace":true,"allow_substring":false,"allow_terminal_punctuation":true},"tags":["error_detection","casefold_deduplication"],"notes":"a@x.com and a@X.COM should collapse"}
{"probe_id":"meta.error_detection.L3.005","canonical_id":"meta.error_detection","category":"meta","level":"L3","axis_values":{"failure_signal":"subtle_correctness","self_vs_environment":"no_signal"},"prompt":"Task: compute the median of [10, 12, 13, 14, 15, 50]. Function returned 13.5. Should the result be flagged as incorrect? Reply 'yes' or 'no' only.","ground_truth":"no","scorer":{"type":"exact_match_string","expected":"no","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["error_detection","subtle"],"notes":"median of even-length sorted list = (13+14)/2 = 13.5"}
{"probe_id":"meta.plan_revision.L1.001","canonical_id":"meta.plan_revision","category":"meta","level":"L1","axis_values":{"trigger":"none","revision_depth":"none"},"prompt":"An agent is solving 2x + 5 = 17 by isolation. Step 1: subtract 5 from both sides to get 2x = 12. Step 2: divide by 2 to get x = 6. The agent is about to verify by substitution. Should the agent:\nA) Continue with the verification step.\nB) Abandon this approach and try a different method.\n\nReply with the letter only.","ground_truth":"A","scorer":{"type":"mcq_letter","expected":"A"},"tags":["plan_revision","persist"],"notes":""}
