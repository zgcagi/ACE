{"probe_id":"lang.semantic_grouping.L1.004","canonical_id":"lang.semantic_grouping","category":"lang","level":"L1","axis_values":{"n_groups":"2","category_specificity":"taxonomic"},"prompt":"Partition these 8 words into 2 groups of 4 (gemstones vs. metals). Words: gold, ruby, silver, sapphire, copper, emerald, iron, diamond. Output groups separated by ' | ', items within each group alphabetized, groups ordered by first item. Output only the answer string.","ground_truth":"copper, gold, iron, silver | diamond, emerald, ruby, sapphire","scorer":{"type":"exact_match_string","expected":"copper, gold, iron, silver | diamond, emerald, ruby, sapphire","case_sensitive":false,"strip_whitespace":true},"tags":[],"notes":""}
