{"probe_id":"lang.semantic_grouping.L1.001","canonical_id":"lang.semantic_grouping","category":"lang","level":"L1","axis_values":{"n_groups":"2","category_specificity":"taxonomic"},"prompt":"You are given 8 words. Partition them into exactly 2 groups of 4, where each group shares a semantic category (trees vs. birds). Words: oak, robin, maple, sparrow, pine, eagle, willow, finch. Output the two groups separated by ' | '. Within each group, list the items alphabetically separated by ', '. Order the two groups by the alphabetically-first item in each group. Output only the answer string.","ground_truth":"eagle, finch, robin, sparrow | maple, oak, pine, willow","scorer":{"type":"exact_match_string","expected":"eagle, finch, robin, sparrow | maple, oak, pine, willow","case_sensitive":false,"strip_whitespace":true},"tags":[],"notes":""}
{"probe_id":"lang.semantic_grouping.L1.002","canonical_id":"lang.semantic_grouping","category":"lang","level":"L1","axis_values":{"n_groups":"2","category_specificity":"taxonomic"},"prompt":"You are given 8 words. Partition them into exactly 2 groups of 4 (vehicles vs. fruits). Words: pear, truck, bus, mango, car, plum, train, peach. Output the two groups separated by ' | '. Within each group, list the items alphabetically (', ' separator). Order the two groups by the alphabetically-first item. Output only the answer string.","ground_truth":"bus, car, train, truck | mango, peach, pear, plum","scorer":{"type":"exact_match_string","expected":"bus, car, train, truck | mango, peach, pear, plum","case_sensitive":false,"strip_whitespace":true},"tags":[],"notes":""}
