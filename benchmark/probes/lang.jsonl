{"probe_id":"lang.target_language_compliance.L1.001","canonical_id":"lang.target_language_compliance","category":"lang","level":"L1","axis_values":{"language_family":"latin_script_indo_european","trigger":"explicit_response_language_instruction"},"prompt":"Respond entirely in French. Question: Quelle est la couleur du ciel par temps clair ? Réponds par une courte phrase.","ground_truth":{"canonical":"bleu","acceptable_answers":["bleu","Bleu.","Le ciel est bleu.","Le ciel est bleu","La couleur du ciel est bleue.","Elle est bleue."]},"scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"llm_judge","rubric":"接受且仅接受简短的法语回答，该回答明确肯定在晴朗天气下天空（或其颜色）是蓝色。允许 bleu/bleue 的合理语法形式、大小写和句末标点差异。拒绝否定或反驳该事实的回答、只含无关文本的回答、非法语回答，以及未明确表达蓝色的回答。"}],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["language:fr"]}
