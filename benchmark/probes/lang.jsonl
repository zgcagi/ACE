{"probe_id":"lang.polarity_clash.L1.001","canonical_id":"lang.polarity_clash","category":"lang","level":"L1","axis_values":{"polarity_clash_strength":"overt","context_length":"one_clause"},"prompt":"Which sentence is sarcastic? (A) 'Oh great, another flat tire — just what I needed.' (B) 'I'm glad my car works well today.' Reply with one letter.","ground_truth":"A","scorer":{"type":"mcq_letter","expected":"A"},"tags":[],"notes":""}
