{"probe_id":"math.symbolic_manipulation.L1.004","canonical_id":"math.symbolic_manipulation","category":"math","level":"L1","axis_values":{"expression_size":"small","operation":"factor"},"prompt":"Factor the quadratic x^2 - 7x + 12 over the integers. Output only the product of two monic linear factors in x, without an explicit multiplication sign, e.g. (x-a)(x-b).","ground_truth":"(x-3)(x-4)","scorer":{"type":"regex","pattern":"^\\s*\\(\\s*x\\s*-\\s*3\\s*\\)\\s*\\(\\s*x\\s*-\\s*4\\s*\\)\\s*$|^\\s*\\(\\s*x\\s*-\\s*4\\s*\\)\\s*\\(\\s*x\\s*-\\s*3\\s*\\)\\s*$","flags":["i"],"allow_symbolic_equivalence":false},"tags":["math","symbolic","factor"],"notes":"Either order accepted; factorized representation is required"}
{"probe_id":"math.symbolic_manipulation.L1.005","canonical_id":"math.symbolic_manipulation","category":"math","level":"L1","axis_values":{"expression_size":"small","operation":"simplify"},"prompt":"Simplify (x^2 - 1)/(x - 1) for x ≠ 1. Output only the simplified expression.","ground_truth":"x + 1","scorer":{"type":"regex","pattern":"^\\s*x\\s*\\+\\s*1\\s*$","flags":["i"]},"tags":["math","symbolic","simplify"],"notes":""}
{"probe_id":"math.symbolic_manipulation.L2.001","canonical_id":"math.symbolic_manipulation","category":"math","level":"L2","axis_values":{"expression_size":"medium","operation":"simplify"},"prompt":"Simplify (x^2 - 9) / (x^2 - 6x + 9) for x ≠ 3. Output only the fully simplified rational expression.","ground_truth":"(x+3)/(x-3)","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["The response is a valid mathematical expression equivalent to (x+3)/(x-3) over the original domain (x != 3).","The response contains only the requested expression, apart from harmless surrounding whitespace or math delimiters."],"fail_criteria":["The submitted expression is undefined, malformed, or not mathematically equivalent to the target.","The response changes the original domain or introduces an invalid extra solution/restriction."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["math","symbolic","simplify"],"notes":""}
{"probe_id":"math.symbolic_manipulation.L2.002","canonical_id":"math.symbolic_manipulation","category":"math","level":"L2","axis_values":{"expression_size":"medium","operation":"differentiate"},"prompt":"Compute d/dx of ln(sin x). Output only the derivative in plain text, using exactly either cot(x) or cos(x)/sin(x).","ground_truth":"cot(x)","scorer":{"type":"regex","pattern":"^\\s*(cot\\s*\\(\\s*x\\s*\\)|cos\\s*\\(?\\s*x\\s*\\)?\\s*/\\s*sin\\s*\\(?\\s*x\\s*\\)?)\\s*$","flags":["i"]},"tags":["math","symbolic","derivative"],"notes":""}
{"probe_id":"math.symbolic_manipulation.L2.003","canonical_id":"math.symbolic_manipulation","category":"math","level":"L2","axis_values":{"expression_size":"medium","operation":"integrate"},"prompt":"Compute ∫ 2x cos(x^2) dx. Output only the antiderivative without the constant of integration.","ground_truth":"sin(x^2)","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":["The response is a valid mathematical expression algebraically equivalent to sin(x^2).","The response contains only the requested antiderivative, apart from harmless surrounding whitespace or math delimiters."],"fail_criteria":["The expression differentiates to something other than 2*x*cos(x^2).","The response gives the integrand or a derivative instead of an antiderivative, or contains unrelated prose."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":["math","symbolic","integral"],"notes":""}
{"probe_id":"math.symbolic_manipulation.L2.004","canonical_id":"math.symbolic_manipulation","category":"math","level":"L2","axis_values":{"expression_size":"medium","operation":"simplify"},"prompt":"For x ≠ ±1, combine into a single rational expression: 1/(x-1) - 1/(x+1). Output a single fraction whose numerator is expanded and whose denominator is factored.","ground_truth":"2/((x-1)(x+1))","scorer":{"type":"regex","pattern":"^\\s*(?:2/\\(\\(x\\-1\\)\\(x\\+1\\)\\)|2/\\(\\(x\\-1\\)\\*\\(x\\+1\\)\\)|2/\\(\\(x\\+1\\)\\(x\\-1\\)\\)|2/\\(\\(x\\+1\\)\\*\\(x\\-1\\)\\))\\s*$","allow_symbolic_equivalence":false,"latex_fraction_preserve_grouping":true},"tags":["math","symbolic","simplify"],"notes":"The denominator must remain factored; algebraically equivalent expanded forms do not satisfy this representation contract."}
{"probe_id":"math.symbolic_manipulation.L2.005","canonical_id":"math.symbolic_manipulation","category":"math","level":"L2","axis_values":{"expression_size":"medium","operation":"simplify"},"prompt":"Simplify sin(2x)/sin(x) for sin(x) ≠ 0. Output only the simplified expression, using `cos(x)` notation and writing the numerical coefficient first.","ground_truth":"2cos(x)","scorer":{"type":"regex","pattern":"^\\s*2\\s*\\*?\\s*cos\\s*\\(\\s*x\\s*\\)\\s*$","flags":["i"],"allow_symbolic_equivalence":false},"tags":["math","symbolic","trig"],"notes":"Coefficient-first cos(x) representation is required"}
{"probe_id":"math.symbolic_manipulation.L3.001","canonical_id":"math.symbolic_manipulation","category":"math","level":"L3","axis_values":{"expression_size":"large_with_chain","operation":"limit"},"prompt":"Evaluate the limit lim_{x→0} (sin(3x) − 3x) / x^3. Output only the exact value as a reduced ASCII fraction in the form p/q.","ground_truth":"-9/2","scorer":{"type":"regex","pattern":"^\\s*[-−]\\s*9\\s*/\\s*2\\s*$","flags":[],"allow_symbolic_equivalence":false},"tags":["math","symbolic","limit"],"notes":"Taylor: sin(3x) = 3x - 9x^3/2 + ...; reduced ASCII p/q is required"}
{"probe_id":"math.symbolic_manipulation.L3.002","canonical_id":"math.symbolic_manipulation","category":"math","level":"L3","axis_values":{"expression_size":"short_product_with_log_derivative","operation":"differentiate"},"prompt":"Let y = x^x for x > 0. Compute the value of dy/dx at x = 1. Output only the integer.","ground_truth":"1","scorer":{"type":"exact_match_numeric","expected":1,"tolerance":0,"require_only_numeric_output":true},"tags":["math","symbolic","derivative"],"notes":"y' = x^x(ln x + 1); at x=1: 1·(0+1)=1"}
