{"probe_id":"read.formal_notation_parse.L2.004","canonical_id":"read.formal_notation_parse","category":"read","level":"L2","axis_values":{"quantifier_depth":"parallel_single_index_definitions","notation_density":"moderate"},"prompt":"For all i ∈ {1,2,3}, let c_i = i!. For all j ∈ {1,2}, let d_j = c_j · 2. Compute d_1 + d_2. Output only the integer.","ground_truth":"6","scorer":{"type":"exact_match_string","expected":"6","case_sensitive":false,"strip_whitespace":true,"allow_substring":false},"tags":["multi_indexed"]}
