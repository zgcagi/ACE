{"probe_id":"logic.composite_truth_judgment.L1.004","canonical_id":"logic.composite_truth_judgment","category":"logic","level":"L1","axis_values":{"n_statements":"two","claim_independence":"independent"},"prompt":"Evaluate each statement as true or false using widely accepted facts.\n\nStatement 1: A leap year has 366 days.\nStatement 2: The novel 'War and Peace' was written by William Shakespeare.\n\nOutput exactly one of: TT, TF, FT, FF.","ground_truth":"TF","scorer":{"type":"exact_match_string","expected":"TF","case_sensitive":true,"strip_whitespace":true},"tags":["composite"]}
{"probe_id":"logic.composite_truth_judgment.L1.005","canonical_id":"logic.composite_truth_judgment","category":"logic","level":"L1","axis_values":{"n_statements":"two","claim_independence":"independent"},"prompt":"Evaluate each statement as true or false using widely accepted facts.\n\nStatement 1: The principal square root of 81 is 9.\nStatement 2: A typical adult human skeleton has 206 bones.\n\nOutput exactly one of: TT, TF, FT, FF.","ground_truth":"TT","scorer":{"type":"exact_match_string","expected":"TT","case_sensitive":true,"strip_whitespace":true,"allow_substring":false},"tags":["composite"]}
