{"probe_id":"dialog.multi_turn_coherence.L1.003","canonical_id":"dialog.multi_turn_coherence","category":"dialog","level":"L1","axis_values":{"turns_back":"1-2","interference":"clean"},"prompt":"Read the dialog and answer the question.\n\nT1 User: The conference is on the 15th of October.\nT1 Assistant: Got it.\nT2 User: What date did I say the conference is on?\n\nReply in the form 'October 15' (no year, no ordinal).","ground_truth":"October 15","scorer":{"type":"exact_match_string","expected":"October 15","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["recall","date"],"notes":""}
{"probe_id":"dialog.multi_turn_coherence.L1.004","canonical_id":"dialog.multi_turn_coherence","category":"dialog","level":"L1","axis_values":{"turns_back":"1-2","interference":"clean"},"prompt":"Read the dialog and answer the question.\n\nT1 User: My budget for the trip is $1,200.\nT1 Assistant: Understood.\nT2 User: How much did I say my budget is? Output the dollar amount with sign and comma exactly as I wrote it.","ground_truth":"$1,200","scorer":{"type":"exact_match_string","expected":"$1,200","case_sensitive":false,"strip_whitespace":true,"allow_terminal_punctuation":true},"tags":["recall","numeric"],"notes":""}
