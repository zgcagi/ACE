{"probe_id":"code.api_idiomatic_use.L2.001","canonical_id":"code.api_idiomatic_use","category":"code","level":"L2","axis_values":{"api_obscurity":"specialized_subpackage","composition_depth":"few_calls","version_sensitivity":"stable"},"system_prompt":"","prompt":"Write a Python function `top5_by_total(df)` that takes a pandas DataFrame with columns ['country','sales'] and returns a DataFrame with the 5 countries with the largest total sales, sorted descending, with two columns 'country' and 'sales'. Use groupby/sum/sort_values/head. Output only the function.","ground_truth":"def top5_by_total(df):\n    return df.groupby('country', as_index=False)['sales'].sum().sort_values('sales', ascending=False).head(5).reset_index(drop=True)","scorer":{"type":"code_parse_ast","parser":"python","checks":{"function":"top5_by_total","calls":["groupby","sum","sort_values","head"],"constants":["country","sales",5]}},"tags":["api","pandas","pipeline"],"notes":""}
