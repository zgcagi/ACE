{"probe_id":"code.import_resolution.L3.002","canonical_id":"code.import_resolution","category":"code","level":"L3","axis_values":{"symbol_count":"many_across_packages","default_vs_named":"mixed_default_named"},"system_prompt":"","prompt":"Write only the import declarations needed for the following TSX. Assume React 17+ automatic JSX runtime, so no `React` import is needed. Import only symbols referenced by the code; do not import unused symbols.\n```\nfunction App(){return <ThemeProvider theme={theme}><CssBaseline/><Router><Routes><Route path='/' element={<Home/>}/></Routes></Router></ThemeProvider>}\n```\n`@mui/material/styles` named-exports `ThemeProvider`; `@mui/material/CssBaseline` default-exports `CssBaseline`; `react-router-dom` named-exports `BrowserRouter`, `Routes`, and `Route`; `./theme` default-exports `theme`; `./Home` default-exports `Home`. Use `BrowserRouter` under the local name `Router`.","ground_truth":"import { ThemeProvider } from '@mui/material/styles';\nimport CssBaseline from '@mui/material/CssBaseline';\nimport { BrowserRouter as Router, Routes, Route } from 'react-router-dom';\nimport theme from './theme';\nimport Home from './Home';","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"imports":["ThemeProvider","CssBaseline","BrowserRouter","Router","Routes","Route","theme","Home"],"import_sources":["@mui/material/styles","@mui/material/CssBaseline","react-router-dom","./theme","./Home"],"required_literal_patterns":["(?m)^[ \\t]*import[ \\t]+\\{(?=[^}\\n]*\\bThemeProvider\\b)[ \\t]*[A-Za-z_$][\\w$]*(?:[ \\t]+as[ \\t]+[A-Za-z_$][\\w$]*)?(?:[ \\t]*,[ \\t]*[A-Za-z_$][\\w$]*(?:[ \\t]+as[ \\t]+[A-Za-z_$][\\w$]*)?)*[ \\t]*\\}[ \\t]+from[ \\t]+(['\\\"])@mui/material/styles\\1[ \\t]*;?[ \\t]*$","(?m)^[ \\t]*import[ \\t]+CssBaseline[ \\t]+from[ \\t]+(['\\\"])@mui/material/CssBaseline\\1[ \\t]*;?[ \\t]*$","(?m)^[ \\t]*import[ \\t]+\\{(?=[^}\\n]*\\bBrowserRouter[ \\t]+as[ \\t]+Router\\b)(?=[^}\\n]*\\bRoutes\\b)(?=[^}\\n]*\\bRoute\\b)[ \\t]*[A-