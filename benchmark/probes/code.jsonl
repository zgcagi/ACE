{"probe_id":"code.component_authoring.L1.005","canonical_id":"code.component_authoring","category":"code","level":"L1","axis_values":{"tree_depth":"single_element","composition":"no_subcomponents"},"system_prompt":"","prompt":"Write a React TSX component `Spacer` that renders a single <div> with inline style height={n} where n is a `size: number` prop. Output only the component.","ground_truth":"export function Spacer({size}:{size:number}){return <div style={{height:size}}/>}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Spacer"],"props":{"size":"number"},"jsx_tag_counts":{"div":1},"required_patterns":["<div\\b(?=[^>]*\\bstyle\\s*=\\s*\\{\\{)(?=[^>]*\\bheight\\s*:\\s*size\\s*(?:[,}]|$))[^>]*/?>"],"component_contract":{"binding":"Spacer","return_checks":{"required_patterns":["<div\\b(?=[^>]*\\bstyle\\s*=\\s*\\{\\{)(?=[^>]*\\bheight\\s*:\\s*size\\s*(?:[,}]|$))[^>]*/?>"]}}}},"tags":["component","spacer"],"notes":""}
{"probe_id":"code.component_authoring.L2.001","canonical_id":"code.component_authoring","category":"code","level":"L2","axis_values":{"tree_depth":"few_children","composition":"inline_helpers"},"system_prompt":"","prompt":"Write a React TSX file defining a `UserCard` component. It must accept `user: { name: string; admin: boolean }`, render the user's name, and render `<Badge>Admin</Badge>` only when `user.admin` is true. Define `Badge` as a local subcomponent in the same file. Equivalent function declarations or arrow-function components are allowed. Output only the file content.","ground_truth":"import type { ReactNode } from 'react';\n\nfunction Badge({ children }: { children: ReactNode }) {\n  return <span style={{ background: '#fc0', padding: 2 }}>{children}</span>;\n}\n\nexport function UserCard({ user }: { user: { name: string; admin: boolean } }) {\n  return <div><span>{user.name}</span>{user.admin && <Badge>Admin</Badge>}</div>;\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Badge","UserCard"],"calls":[],"string_literals":[],"required_patterns":["user\\.name","user\\.admin\\s*(?:&&|\\?)"],"required_any_patterns":[],"pattern_counts":{},"required_jsx_patterns":["<Badge(?:\\s[^>]*)?>\\s*Admin\\s*</Badge>"],"jsx_texts":["Admin"]}},"tags":["component","helper","conditional"],"notes":""}
{"probe_id":"code.component_authoring.L2.002","canonical_id":"code.component_authoring","category":"code","level":"L2","axis_values":{"tree_depth":"few_children","composition":"inline_helpers"},"system_prompt":"","prompt":"Write a React TSX `ProductList` component that takes `items: { id: string; price: number }[]`. Define a `Row` helper component in the same file (do not import it). Render a `<ul>` containing one `<Row>` per item, using `item.id` as the React key. Each row must render a `<li>` whose visible text is `id: $price`, where `price` is formatted with `price.toFixed(2)`. Output only the file content.","ground_truth":"function Row({id, price}:{id:string; price:number}){return <li>{id}: ${price.toFixed(2)}</li>}\nexport function ProductList({items}:{items:{id:string;price:number}[]}){return <ul>{items.map(p=>(<Row key={p.id} id={p.id} price={p.price}/>))}</ul>}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Row","ProductList"],"calls":["map","toFixed"],"string_literals":[],"required_patterns":["<ul\\b","<Row\\b[^>]*key\\s*=\\s*\\{\\s*\\w+\\.id\\s*\\}","<li\\b[\\s\\S]*toFixed\\s*\\(\\s*2\\s*\\)"],"required_any_patterns":[],"pattern_counts":{}}},"tags":["component","list","helper"],"notes":""}
{"probe_id":"code.component_authoring.L2.003","canonical_id":"code.component_authoring","category":"code","level":"L2","axis_values":{"tree_depth":"few_children","composition":"inline_helpers"},"system_prompt":"","prompt":"Write a self-contained React TSX file that exports an `Alert` component. Import `ReactNode` as a type from `react`. The component must accept props `{ severity: 'info' | 'warn' | 'error'; children: ReactNode }`, render its children inside a `div`, and set that div's inline `background` style from the severity. In the same file, define a helper function named `colorFor(severity)` that uses a `switch` statement to return a distinct color string for each severity. Output only the file content.","ground_truth":"import type { ReactNode } from 'react';\n\ntype Severity = 'info' | 'warn' | 'error';\n\nfunction colorFor(severity: Severity): string {\n  switch (severity) {\n    case 'info':\n      return '#dff';\n    case 'warn':\n      return '#ffd';\n    case 'error':\n      return '#fdd';\n  }\n}\n\nexport function Alert({ severity, children }: { severity: Severity; children: ReactNode }) {\n  return <div style={{ background: colorFor(severity) }}>{children}</div>;\n}\n","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["colorFor","Alert"],"calls":["colorFor"],"imports":["ReactNode"],"import_sources":["react"],"jsx_tag_counts":{"div":1},"required_patterns":["\\bswitch\\s*\\(\\s*severity\\s*\\)","<div\\b(?=[^>]*\\bstyle\\s*=\\s*\\{\\{)(?=[^>]*\\bbackground\\s*:\\s*colorFor\\s*\\(\\s*severity\\s*\\))[^>]*>\\s*\\{\\s*children\\s*\\}\\s*</div>"],"required_literal_patterns":["\\bcase\\s*(['\\\"])info\\1\\s*:\\s*return\\s*(['\\\"])[^'\\\"]+\\2","\\bcase\\s*(['\\\"])warn\\1\\s*:\\s*return\\s*(['\\\"])[^'\\\"]+\\2","\\bcase\\s*(['\\\"])error\\1\\s*:\\s*return\\s*(['\\\"])[^'\\\"]+\\2"],"literal_pattern_counts":{"\\bcase\\s*(['\\\"])(?:info|warn|error)\\1\\s*:":3},"required_jsx_patterns":["<div\\b[^>]*>\\s*\\{\\s*children\\s*\\}\\s*</div>"],"component_contract":{"binding":"Alert","return_checks":{"required_patterns":["<div\\b(?=[^>]*\\bstyle\\s*=\\s*\\{\\{)(?=[^>]*\\bbackground\\s*:\\s*colorFor\\s*\\(\\s*severity\\s*\\))[^>]*>\\s*\\{\\s*children\\s*\\}\\s*</div>"]}},"distinct_switch_returns":{"binding":"colorFor","discriminant":"severity","cases":["info","warn","error"]}}},"tags":["component","helper","switch"],"notes":""}
{"probe_id":"code.component_authoring.L2.004","canonical_id":"code.component_authoring","category":"code","level":"L2","axis_values":{"tree_depth":"few_children","composition":"inline_helpers"},"system_prompt":"","prompt":"Write a single React TSX file that exports a `RatingStars` component with props `{ value: number }`. Assume `value` is an integer from 0 through 5 inclusive. In the same file, define a local `Star` helper component that accepts `{ filled: boolean }` and renders `★` when filled and `☆` otherwise. `RatingStars` must render one wrapper element whose direct contents are exactly five `Star` elements, indexed 0 through 4, where the Star at index `i` receives `filled={i < value}`. Do not import `Star`. Output only the file content.","ground_truth":"function Star({ filled }: { filled: boolean }) {\n  return <span>{filled ? '★' : '☆'}</span>\n}\n\nexport function RatingStars({ value }: { value: number }) {\n  return (\n    <span>\n      {Array.from({ length: 5 }, (_, i) => (\n        <Star key={i} filled={i < value} />\n      ))}\n    </span>\n  )\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Star","RatingStars"],"calls":["Array.from"],"string_literals":["★","☆"],"required_patterns":["length\\s*:\\s*5","filled\\s*=\\s*\\{\\s*\\w+\\s*<\\s*value\\s*\\}"],"required_any_patterns":[],"pattern_counts":{}}},"tags":["component","helper","loop"],"notes":""}
{"probe_id":"code.component_authoring.L2.005","canonical_id":"code.component_authoring","category":"code","level":"L2","axis_values":{"tree_depth":"few_children","composition":"inline_helpers"},"system_prompt":"","prompt":"Write a React TSX `Breadcrumbs` component taking `crumbs: {label: string; href?: string}[]`. Define a local inline helper component named `Crumb` inside `Breadcrumbs`. Render the crumbs in order, separated by the text ` / ` (with no leading or trailing separator). When `href !== undefined` (including `href === ''`), render the label as `<a href={href}>`; otherwise render it as `<span>`. Output only the file content.","ground_truth":"export function Breadcrumbs({ crumbs }: { crumbs: { label: string; href?: string }[] }) {\n  function Crumb({ c }: { c: { label: string; href?: string } }) {\n    return c.href !== undefined ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>;\n  }\n\n  return (\n    <nav>\n      {crumbs.map((c, i) => (\n        <span key={i}>\n          {i > 0 && \" / \"}\n          <Crumb c={c} />\n        </span>\n      ))}\n    </nav>\n  );\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Breadcrumbs","Crumb"],"calls":["map"],"string_literals":[" / "],"required_patterns":["href\\s*!==\\s*undefined","<a\\b[^>]*href\\s*=\\s*\\{","\\w+\\s*>\\s*0\\s*&&"],"required_any_patterns":[],"pattern_counts":{}}},"tags":["component","helper","conditional"],"notes":""}
{"probe_id":"code.component_authoring.L3.001","canonical_id":"code.component_authoring","category":"code","level":"L3","axis_values":{"tree_depth":"deeply_nested","composition":"multiple_components"},"system_prompt":"","prompt":"Write a single self-contained React TSX file. Define a non-exported shared type exactly equivalent to `type LayoutProps = { title: string }`. Define non-exported `Header`, `Sidebar`, `MainContent`, and `Footer` components in the same file. Both `Header` and the exported `Dashboard` component must use `LayoutProps` for their props. `Dashboard` must render Header at the top, then a flex row containing Sidebar and MainContent as sibling children, then Footer at the bottom. Use inline style objects for the required column/page and row/content layout. Do not import or define components in another file. Output only the file content.","ground_truth":"type LayoutProps = { title: string };\n\nfunction Header({ title }: LayoutProps) {\n  return <header>{title}</header>;\n}\n\nfunction Sidebar() {\n  return <aside>side</aside>;\n}\n\nfunction MainContent() {\n  return <main>main</main>;\n}\n\nfunction Footer() {\n  return <footer>©</footer>;\n}\n\nexport function Dashboard({ title }: LayoutProps) {\n  return (\n    <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh' }}>\n      <Header title={title} />\n      <div style={{ display: 'flex', flex: 1 }}>\n        <Sidebar />\n        <MainContent />\n      </div>\n      <Footer />\n    </div>\n  );\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Header","Sidebar","MainContent","Footer","Dashboard"],"calls":[],"string_literals":[],"required_patterns":["type\\s+LayoutProps\\s*=\\s*\\{\\s*title\\s*:\\s*string","<Header\\b[\\s\\S]*<Sidebar\\b[\\s\\S]*<MainContent\\b[\\s\\S]*<Footer\\b"],"required_any_patterns":[],"pattern_counts":{},"required_literal_patterns":["flexDirection\\s*:\\s*['\\\"]column['\\\"]"]}},"tags":["component","multi","shared_types"],"notes":""}
{"probe_id":"code.component_authoring.L3.002","canonical_id":"code.component_authoring","category":"code","level":"L3","axis_values":{"tree_depth":"deeply_nested","composition":"multiple_components"},"system_prompt":"","prompt":"Write a single TSX file. Define a shared `type Card = { id: string; text: string }` and internally define `Card`, `Column`, and `AddCardForm`. Export a named `KanbanBoard` component that takes `columns: { id: string; title: string; cards: Card[] }[]`. KanbanBoard must render one Column per input column; each Column must render its title, one Card per card, and an AddCardForm. AddCardForm should accept an `onAdd(text: string)` callback and call it when its form is submitted. No persistence or parent-state update is required. Output only the file.","ground_truth":"type Card = { id: string; text: string };\n\nfunction Card({ card }: { card: Card }) {\n  return <div className=\"card\">{card.text}</div>;\n}\n\nfunction AddCardForm({ onAdd }: { onAdd: (text: string) => void }) {\n  return (\n    <form onSubmit={(event) => {\n      event.preventDefault();\n      const input = event.currentTarget.elements.namedItem(\"text\") as HTMLInputElement;\n      const text = input.value.trim();\n      if (text) onAdd(text);\n      input.value = \"\";\n    }}>\n      <input name=\"text\" />\n      <button type=\"submit\">Add</button>\n    </form>\n  );\n}\n\nfunction Column({ title, cards, onAdd }: { title: string; cards: Card[]; onAdd: (text: string) => void }) {\n  return (\n    <section className=\"column\">\n      <h3>{title}</h3>\n      {cards.map((card) => <Card key={card.id} card={card} />)}\n      <AddCardForm onAdd={onAdd} />\n    </section>\n  );\n}\n\nexport function KanbanBoard({ columns }: { columns: { id: string; title: string; cards: Card[] }[] }) {\n  return (\n    <div className=\"board\">\n      {columns.map((column) => (\n        <Column key={column.id} title={column.title} cards={column.cards} onAdd={() => {}} />\n      ))}\n    </div>\n  );\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Card","Column","AddCardForm","KanbanBoard"],"calls":["map","onAdd"],"string_literals":[],"required_patterns":["type\\s+Card\\s*=","columns\\s*\\.\\s*map","(?:column\\.)?cards\\s*\\.\\s*map","<AddCardForm\\b[^>]*onAdd","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{","\\bonSubmit\\s*=\\s*\\{"],"required_any_patterns":[],"pattern_counts":{}}},"tags":["component","multi","kanban"],"notes":""}
{"probe_id":"code.component_authoring.L3.003","canonical_id":"code.component_authoring","category":"code","level":"L3","axis_values":{"tree_depth":"deeply_nested","composition":"multiple_components"},"system_prompt":"","prompt":"Write a single valid TSX file. Declare and use a shared `type Msg = { id: string; from: string; body: string }`. Export exactly one named component, `ChatWindow`; define `MessageList`, `Message`, and `Composer` in the same file without exporting them. `ChatWindow` must render `MessageList` and `Composer`. `MessageList` must accept an array of `Msg` and render one `Message` per item in a vertically stacked container. `Message` must display the sender and body. `Composer` must render a textarea and a button whose visible label is `Send`. Output only the file content.","ground_truth":"import { useState } from 'react';\n\ntype Msg = { id: string; from: string; body: string };\n\nfunction Message({ message }: { message: Msg }) {\n  return <div><strong>{message.from}:</strong> {message.body}</div>;\n}\n\nfunction MessageList({ messages }: { messages: Msg[] }) {\n  return <div className=\"messages\">{messages.map((message) => <Message key={message.id} message={message} />)}</div>;\n}\n\nfunction Composer({ onSend }: { onSend: (body: string) => void }) {\n  const [body, setBody] = useState('');\n  return <div><textarea value={body} onChange={(event) => setBody(event.target.value)} /><button onClick={() => onSend(body)}>Send</button></div>;\n}\n\nexport function ChatWindow({ messages }: { messages: Msg[] }) {\n  return <div><MessageList messages={messages} /><Composer onSend={() => {}} /></div>;\n}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Message","MessageList","Composer","ChatWindow"],"calls":["map"],"string_literals":[],"required_patterns":["type\\s+Msg\\s*=","<textarea\\b","<MessageList\\b[\\s\\S]*<Composer\\b"],"required_any_patterns":[],"pattern_counts":{},"required_jsx_patterns":[">\\s*Send\\s*<"],"jsx_texts":["Send"]}},"tags":["component","multi","chat"],"notes":""}
{"probe_id":"code.component_authoring.L3.004","canonical_id":"code.component_authoring","category":"code","level":"L3","axis_values":{"tree_depth":"deeply_nested","composition":"multiple_components"},"system_prompt":"","prompt":"Write a TSX file for React. Export `type TreeNode<T> = { value: T; children: TreeNode<T>[] }` and export a generic `TreeView<T>` component. `TreeView` must accept props `{ root: TreeNode<T>; render: (value: T) => ReactNode }`. Define, but do not export, a recursive generic `Node<T>` component internally. Render the root and all descendants as nested `<ul>/<li>` elements: each node's value must be rendered with `render`, and a child `<ul>` should be rendered only when the node has children. You may use `import type { ReactNode } from 'react'`. Output only the file content.","ground_truth":"import type { ReactNode } from 'react';\n\nexport type TreeNode<T> = {\n  value: T;\n  children: TreeNode<T>[];\n};\n\ntype NodeProps<T> = {\n  node: TreeNode<T>;\n  render: (value: T) => ReactNode;\n};\n\nfunction Node<T>({ node, render }: NodeProps<T>) {\n  return (\n    <li>\n      {render(node.value)}\n      {node.children.length > 0 && (\n        <ul>\n          {node.children.map((child, index) => (\n            <Node key={index} node={child} render={render} />\n          ))}\n        </ul>\n      )}\n    </li>\n  );\n}\n\nexport function TreeView<T>({\n  root,\n  render,\n}: {\n  root: TreeNode<T>;\n  render: (value: T) => ReactNode;\n}) {\n  return (\n    <ul>\n      <Node node={root} render={render} />\n    </ul>\n  );\n}\n","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["Node","TreeView"],"calls":["map"],"imports":["ReactNode"],"import_sources":["react"],"required_patterns":["\\bexport\\s+type\\s+TreeNode\\s*<\\s*T\\s*>\\s*=\\s*\\{(?=[^}]*\\bvalue\\s*:\\s*T\\b)(?=[^}]*\\bchildren\\s*:\\s*TreeNode\\s*<\\s*T\\s*>\\s*\\[\\s*\\])[^}]*\\}","\\b[A-Za-z_$][\\w$]*\\s*\\(\\s*[A-Za-z_$][\\w$]*\\.value\\s*\\)","\\b[A-Za-z_$][\\w$]*\\.children\\.length\\s*>\\s*0\\s*&&","\\b([A-Za-z_$][\\w$]*)\\.children\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,300}?=>[\\s\\S]{0,300}?<Node\\b(?=[^>]*\\bnode\\s*=\\s*\\{\\s*\\2\\s*\\})","<Node\\b(?=[^>]*\\bnode\\s*=\\s*\\{\\s*root\\s*\\})(?=[^>]*\\brender\\s*=\\s*\\{\\s*render\\s*\\})[^>]*/?>","\\bfunction\\s+Node\\s*<\\s*T\\s*>","\\bexport\\s+function\\s+TreeView\\s*<\\s*T\\s*>"],"required_jsx_patterns":["<li\\b[^>]*>[\\s\\S]*\\{[\\s\\S]*\\.value[\\s\\S]*\\}[\\s\\S]*</li>","<ul\\b[^>]*>[\\s\\S]*<Node\\b[\\s\\S]*</ul>"],"component_contracts":[{"binding":"TreeView","return_checks":{"required_patterns":["<ul\\b[^>]*>[\\s\\S]*<Node\\b(?=[^>]*\\bnode\\s*=\\s*\\{\\s*root\\s*\\})(?=[^>]*\\brender\\s*=\\s*\\{\\s*render\\s*\\})[^>]*/?>[\\s\\S]*</ul>"]},"exported":true,"generic":true,"forbid_props_any":true},{"binding":"Node","exported":false,"generic":true,"forbid_props_any":true,"return_checks":{"required_patterns":["<li\\b","\\b[A-Za-z_$][\\w$]*\\s*\\(\\s*[A-Za-z_$][\\w$]*\\.value\\s*\\)","\\b[A-Za-z_$][\\w$]*\\.children\\.length\\s*>\\s*0\\s*&&","\\b([A-Za-z_$][\\w$]*)\\.children\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,300}?=>[\\s\\S]{0,300}?<Node\\b(?=[^>]*\\bnode\\s*=\\s*\\{\\s*\\2\\s*\\})"]}}],"forbidden_patterns":["\\bexport\\s+(?:default\\s+)?function\\s+Node\\b","\\b(?:function\\s+(?:Node|TreeView)[\\s\\S]{0,300}?\\}\\s*:\\s*any\\b|function\\s+(?:Node|TreeView)\\s*\\([^)]*:\\s*any\\b)"]}},"tags":["component","recursive","generic"],"notes":""}
{"probe_id":"code.component_authoring.L3.005","canonical_id":"code.component_authoring","category":"code","level":"L3","axis_values":{"tree_depth":"deeply_nested","composition":"multiple_components"},"system_prompt":"","prompt":"Write a TSX file (assume the automatic React JSX runtime is configured) that exports `DataTable<T>` and defines `THead`, `TRow<T>`, and `Pager` in the same file. `DataTable` accepts `columns: { key: keyof T; label: string }[]`, `rows: T[]`, and a positive-integer `pageSize`. Render a table header from `columns`, render the first page of at most `pageSize` rows through `TRow`, and render `Pager` below the table. For this task, no interactive page switching is required: `Pager` must display exactly `page 1/y`, where `y` is `Math.max(1, ceil(rows.length / pageSize))`. Output only the file.","ground_truth":"function THead<T>({cols}:{cols:{key:keyof T; label:string}[]}){return <thead><tr>{cols.map(c=>(<th key={String(c.key)}>{c.label}</th>))}</tr></thead>}\nfunction TRow<T>({row, cols}:{row:T; cols:{key:keyof T; label:string}[]}){return <tr>{cols.map(c=>(<td key={String(c.key)}>{String(row[c.key])}</td>))}</tr>}\nfunction Pager({page, total}:{page:number; total:number}){return <div>page {page}/{total}</div>}\nexport function DataTable<T>({columns, rows, pageSize}:{columns:{key:keyof T; label:string}[]; rows:T[]; pageSize:number}){const total = Math.max(1, Math.ceil(rows.length/pageSize)); const visible = rows.slice(0, pageSize); return <div><table><THead cols={columns}/><tbody>{visible.map((r,i)=>(<TRow key={i} row={r} cols={columns}/>))}</tbody></table><Pager page={1} total={total}/></div>}","scorer":{"type":"code_parse_ast","parser":"tsx","checks":{"bindings":["THead","TRow","Pager","DataTable"],"calls":["map","slice","Math.max","Math.ceil"],"jsx_tag_counts":{"table":1,"thead":1,"tbody":1},"required_patterns":["\\brows\\s*\\.\\s*slice\\s*\\(\\s*0\\s*,\\s*pageSize\\s*\\)","\\bMath\\.max\\s*\\(\\s*1\\s*,\\s*Math\\.ceil\\s*\\(\\s*rows\\.length\\s*/\\s*pageSize\\s*\\)\\s*\\)","<THead\\b(?=[^>]*\\b[A-Za-z_$][\\w$]*\\s*=\\s*\\{\\s*columns\\s*\\})[^>]*/?>","\\b([A-Za-z_$][\\w$]*)\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,250}?=>[\\s\\S]{0,250}?<TRow\\b(?=[^>]*\\brow\\s*=\\s*\\{\\s*\\2\\s*\\})","\\b([A-Za-z_$][\\w$]*)\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,250}?=>[\\s\\S]{0,250}?<th\\b[\\s\\S]{0,250}?\\{\\s*\\2\\.label\\s*\\}","\\b([A-Za-z_$][\\w$]*)\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,250}?=>[\\s\\S]{0,250}?<td\\b[\\s\\S]{0,250}?\\[[ ]*\\2\\.key[ ]*\\]","\\bfunction\\s+TRow\\s*<\\s*T\\s*>","\\bexport\\s+function\\s+DataTable\\s*<\\s*T\\s*>"],"required_any_patterns":[["<Pager\\b(?=[^>]*\\b[A-Za-z_$][\\w$]*\\s*=\\s*\\{\\s*1\\s*\\})(?=[^>]*\\b[A-Za-z_$][\\w$]*\\s*=\\s*\\{\\s*[A-Za-z_$][\\w$]*\\s*\\})[^>]*/?>",">\\s*page\\s+1\\s*/\\s*\\{\\s*[A-Za-z_$][\\w$]*\\s*\\}\\s*<[\\s\\S]*?<Pager\\b(?=[^>]*\\b[A-Za-z_$][\\w$]*\\s*=\\s*\\{\\s*[A-Za-z_$][\\w$]*\\s*\\})"]],"required_jsx_patterns":["<table\\b[\\s\\S]*<THead\\b[\\s\\S]*<tbody\\b[\\s\\S]*<TRow\\b[\\s\\S]*</tbody>[\\s\\S]*</table>[\\s\\S]*<Pager\\b",">\\s*page\\s+(?:1|\\{\\s*[A-Za-z_$][\\w$]*\\s*\\})\\s*/\\s*\\{\\s*[A-Za-z_$][\\w$]*\\s*\\}\\s*<"],"component_contracts":[{"binding":"DataTable","return_checks":{"required_patterns":["<table\\b[\\s\\S]*<THead\\b[\\s\\S]*<tbody\\b[\\s\\S]*<TRow\\b[\\s\\S]*</tbody>[\\s\\S]*</table>[\\s\\S]*<Pager\\b"]},"exported":true,"generic":true,"forbid_props_any":true},{"binding":"TRow","generic":true,"forbid_props_any":true,"return_checks":{"required_patterns":["<tr\\b[\\s\\S]*\\b([A-Za-z_$][\\w$]*)\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,250}?=>[\\s\\S]{0,250}?<td\\b[\\s\\S]{0,250}?\\[[ ]*\\2\\.key[ ]*\\]"]}},{"binding":"THead","forbid_props_any":true,"return_checks":{"required_patterns":["<thead\\b[\\s\\S]*\\b([A-Za-z_$][\\w$]*)\\.map\\s*\\(\\s*\\(?\\s*([A-Za-z_$][\\w$]*)[\\s\\S]{0,250}?=>[\\s\\S]{0,250}?<th\\b[\\s\\S]{0,250}?\\{\\s*\\2\\.label\\s*\\}"]}},{"binding":"Pager","forbid_props_any":true,"return_checks":{"required_jsx_patterns":[">\\s*page\\s+(?:1|\\{\\s*[A-Za-z_$][\\w$]*\\s*\\})\\s*/\\s*\\{\\s*[A-Za-z_$][\\w$]*\\s*\\}\\s*<"]}}],"forbidden_patterns":["\\bfunction\\s+(?:THead|TRow|Pager|DataTable)[\\s\\S]{0,300}?\\}\\s*:\\s*any\\b"]}},"tags":["component","multi","table","generic"],"notes":""}
