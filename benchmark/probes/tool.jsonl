{"probe_id":"tool.format_robustness.L1.001","canonical_id":"tool.format_robustness","category":"tool","level":"L1","axis_values":{"axis_of_variation":"return_format","axes_combined":"one"},"system_prompt":"","prompt":"Tool documentation (JSON):\n{\"name\":\"add\",\"parameters\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}},\"required\":[\"a\",\"b\"]}}\nUser: \"Add 7 and 11.\"\nReturn format: a single Python-style function call expression on one line, e.g. add(a=1, b=2). Use keyword arguments only. Output only the call.","ground_truth":"add(a=7, b=11)","scorer":{"type":"regex","pattern":"\\Aadd[ \\t]*\\([ \\t]*(?:a[ \\t]*=[ \\t]*7[ \\t]*,[ \\t]*b[ \\t]*=[ \\t]*11|b[ \\t]*=[ \\t]*11[ \\t]*,[ \\t]*a[ \\t]*=[ \\t]*7)[ \\t]*\\)[ \\t]*\\Z"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L1.002","canonical_id":"tool.format_robustness","category":"tool","level":"L1","axis_values":{"axis_of_variation":"function_doc_format","axes_combined":"one"},"system_prompt":"","prompt":"Tool documentation (XML):\n<tool name=\"multiply\"><param name=\"a\" type=\"integer\" required=\"true\"/><param name=\"b\" type=\"integer\" required=\"true\"/></tool>\nUser: \"Multiply 6 by 9.\"\nReturn format: a single JSON object: {\"name\":..., \"arguments\":{...}}. Output only the JSON.","ground_truth":"{\"name\":\"multiply\",\"arguments\":{\"a\":6,\"b\":9}}","scorer":{"type":"structured_json","schema":{"type":"object","properties":{"name":{"const":"multiply"},"arguments":{"type":"object","properties":{"a":{"const":6},"b":{"const":9}},"required":["a","b"],"additionalProperties":false}},"required":["name","arguments"],"additionalProperties":false}},"tags":[],"notes":"Scoring validates the parsed JSON envelope, values, and absence of extra fields; line layout is not graded."}
{"probe_id":"tool.format_robustness.L1.003","canonical_id":"tool.format_robustness","category":"tool","level":"L1","axis_values":{"axis_of_variation":"return_format","axes_combined":"one"},"system_prompt":"","prompt":"Tool documentation (JSON):\n{\"name\":\"power\",\"parameters\":{\"type\":\"object\",\"properties\":{\"base\":{\"type\":\"number\"},\"exponent\":{\"type\":\"number\"}},\"required\":[\"base\",\"exponent\"]}}\nUser: \"Raise 2 to the power 10.\"\nReturn format: a single Python-style call on one line, keyword args only. Output only the call.","ground_truth":"power(base=2, exponent=10)","scorer":{"type":"regex","pattern":"^\\s*power\\s*\\(\\s*(?:base\\s*=\\s*2\\s*,\\s*exponent\\s*=\\s*10|exponent\\s*=\\s*10\\s*,\\s*base\\s*=\\s*2)\\s*\\)\\s*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L1.004","canonical_id":"tool.format_robustness","category":"tool","level":"L1","axis_values":{"axis_of_variation":"return_format","axes_combined":"one"},"system_prompt":"","prompt":"Tool documentation (JSON):\n{\"name\":\"subtract\",\"parameters\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}},\"required\":[\"a\",\"b\"]}}\nUser: \"Subtract 14 from 42 (i.e. 42 minus 14). Bind a=42 (the minuend) and b=14 (the subtrahend).\"\nReturn format: a single XML element on one line: <call name=\"...\"><arg name=\"...\" value=\"...\"/>...</call>. Output only the XML element.","ground_truth":"<call name=\"subtract\"><arg name=\"a\" value=\"42\"/><arg name=\"b\" value=\"14\"/></call>","scorer":{"type":"regex","pattern":"^\\s*<call\\s+name=[\\\"']subtract[\\\"']\\s*>\\s*(?:<arg\\s+name=[\\\"']a[\\\"']\\s+value=[\\\"']42[\\\"']\\s*/>\\s*<arg\\s+name=[\\\"']b[\\\"']\\s+value=[\\\"']14[\\\"']\\s*/>|<arg\\s+name=[\\\"']b[\\\"']\\s+value=[\\\"']14[\\\"']\\s*/>\\s*<arg\\s+name=[\\\"']a[\\\"']\\s+value=[\\\"']42[\\\"']\\s*/>)\\s*</call>\\s*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L1.005","canonical_id":"tool.format_robustness","category":"tool","level":"L1","axis_values":{"axis_of_variation":"prompt_style","axes_combined":"one"},"system_prompt":"","prompt":"Tool documentation (JSON):\n{\"name\":\"greet\",\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}}\nNarrator: \"The user, who is named Priya, would like a greeting addressed to her.\"\nReturn format: single JSON object on one line: {\"name\":..., \"arguments\":{...}}. Output only the JSON.","ground_truth":"{\"name\":\"greet\",\"arguments\":{\"name\":\"Priya\"}}","scorer":{"type":"structured_json","schema":{"type":"object","properties":{"name":{"const":"greet"},"arguments":{"type":"object","properties":{"name":{"const":"Priya"}},"required":["name"],"additionalProperties":false}},"required":["name","arguments"],"additionalProperties":false}},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L2.001","canonical_id":"tool.format_robustness","category":"tool","level":"L2","axis_values":{"axis_of_variation":"function_doc_format","axes_combined":"two"},"system_prompt":"","prompt":"Tool documentation (XML):\n<tool name=\"divide\"><param name=\"numerator\" type=\"number\"/><param name=\"denominator\" type=\"number\"/></tool>\nUser (terse cable-style): \"DIV NUM=100 DEN=4.\"\nReturn format: single Python-style call on one line, keyword args only. Output only the call.","ground_truth":"divide(numerator=100, denominator=4)","scorer":{"type":"regex","pattern":"^divide[ \\t]*\\([ \\t]*(?:numerator[ \\t]*=[ \\t]*100[ \\t]*,[ \\t]*denominator[ \\t]*=[ \\t]*4|denominator[ \\t]*=[ \\t]*4[ \\t]*,[ \\t]*numerator[ \\t]*=[ \\t]*100)[ \\t]*\\)[ \\t]*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L2.002","canonical_id":"tool.format_robustness","category":"tool","level":"L2","axis_values":{"axis_of_variation":"function_doc_format","axes_combined":"two"},"system_prompt":"","prompt":"Tool documentation (XML):\n<tool name=\"get_weather\"><param name=\"city\" type=\"string\" required=\"true\"/></tool>\n\nTo call a tool, output exactly one JSON object using this protocol:\n{\"name\":\"<tool name>\",\"arguments\":{\"<parameter name>\":<parameter value>}}\nDo not answer the weather request directly.\n\nUser (formal third-person): \"The end-user requests the current weather for the city of Helsinki.\"\nReturn only the tool-call JSON object, with no Markdown, explanation, or line breaks.","ground_truth":"{\"name\":\"get_weather\",\"arguments\":{\"city\":\"Helsinki\"}}","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"raw_json_with_schema","requirements":{"single_line":true,"no_surrounding_text":true},"schema":{"type":"object","properties":{"name":{"const":"get_weather"},"arguments":{"type":"object","properties":{"city":{"const":"Helsinki"}},"required":["city"],"additionalProperties":false}},"required":["name","arguments"],"additionalProperties":false}}],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":[]}
{"probe_id":"tool.format_robustness.L2.003","canonical_id":"tool.format_robustness","category":"tool","level":"L2","axis_values":{"axis_of_variation":"function_doc_format","axes_combined":"two"},"system_prompt":"","prompt":"Tool documentation (markdown table):\n| name | parameters |\n|------|------------|\n| concat | a:string, b:string |\nUser (telegram-style): \"CONCAT A=hello B=world.\"\nReturn format: single JSON object on one line. Output only the JSON.\nProtocol: do not execute the tool or return its result. Output JSON only. The tool call must be exactly one object with the envelope {\"name\":\"<exact tool name>\",\"arguments\":{...}}. The literal field names \"name\" and \"arguments\" are required, no outer fields are allowed, and every named parameter must be placed inside \"arguments\".","ground_truth":"{\"name\":\"concat\",\"arguments\":{\"a\":\"hello\",\"b\":\"world\"}}","scorer":{"type":"structured_json","schema":{"type":"object","properties":{"name":{"const":"concat"},"arguments":{"type":"object","properties":{"a":{"const":"hello"},"b":{"const":"world"}},"required":["a","b"],"additionalProperties":false}},"required":["name","arguments"],"additionalProperties":false}},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L2.004","canonical_id":"tool.format_robustness","category":"tool","level":"L2","axis_values":{"axis_of_variation":"return_format","axes_combined":"two"},"system_prompt":"","prompt":"Tool documentation (XML):\n<tool name=\"set_alarm\"><param name=\"hour\" type=\"integer\"/><param name=\"minute\" type=\"integer\"/></tool>\nUser (script direction): \"[ALARM REQ] hour: 7, minute: 15\"\nReturn format: single XML element on one line: <call name=\"...\"><arg name=\"...\" value=\"...\"/>...</call>. Output only the element.","ground_truth":"<call name=\"set_alarm\"><arg name=\"hour\" value=\"7\"/><arg name=\"minute\" value=\"15\"/></call>","scorer":{"type":"regex","pattern":"^<call name=\"set_alarm\">[ \\t]*<arg name=\"hour\"[ \\t]+value=\"7\"[ \\t]*/>[ \\t]*<arg name=\"minute\"[ \\t]+value=\"15\"[ \\t]*/>[ \\t]*</call>[ \\t]*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L2.005","canonical_id":"tool.format_robustness","category":"tool","level":"L2","axis_values":{"axis_of_variation":"return_format","axes_combined":"two"},"system_prompt":"","prompt":"Tool documentation (markdown):\n### `lookup_zip(zip_code: string)`\nReturns city for a US zip code.\nUser (system-log voice): \"REQ: lookup_zip 94110.\"\nReturn format: single Python-style call on one line, keyword args only.","ground_truth":"lookup_zip(zip_code='94110')","scorer":{"type":"regex","pattern":"^lookup_zip\\s*\\(\\s*zip_code\\s*=\\s*(?:'94110'|\\\"94110\\\")\\s*\\)\\s*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L3.001","canonical_id":"tool.format_robustness","category":"tool","level":"L3","axis_values":{"axis_of_variation":"return_format","axes_combined":"three"},"system_prompt":"","prompt":"Tool documentation (XML, attribute style):\n<tool name=\"translate\" target_lang=\"string\" source_lang=\"string\" text=\"string\" required=\"text,target_lang\"/>\nUser (poetic third-person voice): \"Pray, render unto our visitor the French equivalent of the English greeting `hello`.\"\nReturn format: a single Python-style call on one line, keyword arguments only. Use exactly text and target_lang, in that order. Output only the call.","ground_truth":"translate(text=\"hello\", target_lang=\"French\")","scorer":{"type":"regex","pattern":"\\Atranslate[ \\t]*\\([ \\t]*text[ \\t]*=[ \\\"']hello[\\\"'][ \\t]*,[ \\t]*target_lang[ \\t]*=[ \\\"']French[\\\"'][ \\t]*\\)[ \\t]*\\Z"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L3.002","canonical_id":"tool.format_robustness","category":"tool","level":"L3","axis_values":{"axis_of_variation":"return_format","axes_combined":"three"},"system_prompt":"","prompt":"Tool documentation (YAML):\nname: book_table\nparameters:\n  restaurant: {type: string, required: true}\n  party_size: {type: integer, required: true}\n  time: {type: string, required: true}\nUser (terse SMS): \"Bk Luigis 4 7pm\" — explicit mapping: restaurant=`Luigis` (verbatim), party_size=4 (integer), time=`19:00` (24-hour HH:MM).\nReturn format: single XML element on one line: <call name=\"...\"><arg name=\"...\" value=\"...\"/>...</call>. Output only the element.","ground_truth":"<call name=\"book_table\"><arg name=\"restaurant\" value=\"Luigis\"/><arg name=\"party_size\" value=\"4\"/><arg name=\"time\" value=\"19:00\"/></call>","scorer":{"type":"judge_rubric","rubric":{"version":"1","pass_criteria":[{"type":"xml_semantic","constraints":{"single_line":true,"root":{"tag":"call","attributes":{"name":"book_table"}},"children":{"tag":"arg","exact_count":3,"match_as_unordered_set":true,"required_attribute_pairs":[{"name":"restaurant","value":"Luigis"},{"name":"party_size","value":"4"},{"name":"time","value":"19:00"}]},"no_extra_root_attributes":true,"no_extra_children":true,"output_only_xml_element":true}}],"fail_criteria":["Fail if any mandatory task or pass criterion is unsatisfied, or if any rejection, forbidden, or failure condition stated inside a criterion is triggered."],"pass_rule":"all pass criteria and no fail criteria"}},"tags":[]}
{"probe_id":"tool.format_robustness.L3.003","canonical_id":"tool.format_robustness","category":"tool","level":"L3","axis_values":{"axis_of_variation":"return_format","axes_combined":"three"},"system_prompt":"","prompt":"Tool documentation (Java-signature style):\npublic static double sphereVolume(double radius)\nUser (technical telegram): \"VOL SPHERE r=3.5 m, S.I. units.\"\nReturn format: a Java-style call on one line, e.g. `MyClass.method(arg1, arg2)`; use the bare method name `sphereVolume` and one positional argument. Output only the call.","ground_truth":"sphereVolume(3.5)","scorer":{"type":"regex","pattern":"^\\s*sphereVolume\\s*\\(\\s*3\\.5(?:0*)?\\s*\\)\\s*$"},"tags":[],"notes":""}
{"probe_id":"tool.format_robustness.L3.004","canonical_id":"tool.format_robustness","category":"tool","level":"L3","axis_values":{"axis_of_variation":"prompt_style","axes_combined":"three"},"system_prompt":"","prompt":"Tool documentation (TOML):\n[tool]\nname = \"send_sms\"\n[tool.parameters]\nphone = \"string\"\nmessage = \"string\"\n\nTool-call JSON format: output exactly one JSON object of the form {\"name\":\"<tool name>\",\"arguments\":{\"<parameter name>\":\"<value>\"}}. Do not include any additional fields.\n\nUser (haiku-form, third-person): \"They send a missive / to phone `+15550123` / saying `hi mom`.\"\nReturn exactly one minified JSON object on one line. Output only the JSON.","ground_truth":"{\"name\":\"send_sms\",\"arguments\":{\"phone\":\"+15550123\",\"message\":\"hi mom\"}}","scorer":{"type":"structured_json","schema":{"type":"object","properties":{"name":{"const":"send_sms"},"arguments":{"type":"object","properties":{"phone":{"const":"+15550123"},"message":{"const":"hi mom"}},"required":["phone","message"],"additionalProperties":false}},"required":["name","arguments"],"additionalProperties":false}},"tags":[]}
{"probe_id":"tool.format_robustness.L3.005","canonical_id":"tool.format_robustness","category":"tool","level":"L3","axis_values":{"axis_of_variation":"return_format","axes_combined":"three"},"system_prompt":"","prompt":"Tool documentation (JavaScript signature):\nfunction setReminder(text: string, minutes_from_now: number): void\nUser (instant-message slang, no caps): \"yo set a reminder in 25 minutes that says \\\"call mom\\\"\"\nReturn format: a JavaScript-style call on one line with positional arguments in declaration order, using double-quoted strings, e.g. `setReminder(\"...\", 5)`. Output only the call.","ground_truth":"setReminder(\"call mom\", 25)","scorer":{"type":"regex","pattern":"^setReminder[ \\t]*\\([ \\t]*\"call mom\"[ \\t]*,[ \\t]*25[ \\t]*\\)[ \\t]*$"},"tags":[],"notes":""}
